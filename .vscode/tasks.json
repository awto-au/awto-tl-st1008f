{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ST1008 console",
      "detail": "Follow the switch console log live, error lines red (./dev.py console-watch)",
      "type": "shell",
      "command": "${workspaceFolder}/dev.py console-watch",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "ST1008 ssh",
      "detail": "Shell on the switch's running OpenWrt (root@192.168.25.48)",
      "type": "shell",
      "command": "ssh root@192.168.25.48",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "ST1008 mode watch",
      "detail": "Live M1/M2/M3 switch position; prints on every change",
      "type": "shell",
      "command": "${workspaceFolder}/dev.py mode-watch",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    }
  ]
}
