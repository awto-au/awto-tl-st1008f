// SPDX-License-Identifier: GPL-2.0+
/*
 * TP-Link TL-ST1008F v2 (RTL9303), U-Boot stage 0: console + memory only.
 * UART/clock facts match Linux (OpenWrt rtl930x.dtsi, ns16550a @ 0x18002000).
 */
/dts-v1/;

/ {
	compatible = "tplink,tl-st1008f-v2", "realtek,rtl9302-soc";
	model = "TP-Link TL-ST1008F v2.0";
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart0;
		/* i2c0..7 = SFP cage 1..8 (EEPROM 0x50, DDM 0x51); i2c8 = laser TX-disable expander */
		i2c0 = &sfp_i2c0;
		i2c1 = &sfp_i2c1;
		i2c2 = &sfp_i2c2;
		i2c3 = &sfp_i2c3;
		i2c4 = &sfp_i2c4;
		i2c5 = &sfp_i2c5;
		i2c6 = &sfp_i2c6;
		i2c7 = &sfp_i2c7;
		i2c8 = &i2c_exp;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mips,mips34Kc";
			reg = <0>;
		};
	};

	/* Second 256 MiB is not linearly mapped (needs highmem remap). */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x18000000 0x10000>;

		/* Data in bits 31:24 = byte 0 of each 32-bit reg. U-Boot's BE ns16550 reads
		 * byte (1 << shift) - 1; reg-offset -3 (u32 wrap) cancels that. */
		uart0: serial@2000 {
			compatible = "ns16550a";
			reg = <0x2000 0x100>;
			reg-io-width = <1>;
			reg-shift = <2>;
			reg-offset = <0xfffffffd>;
			clock-frequency = <175000000>;	/* LX bus */
			current-speed = <115200>;
			no-loopback-test;
		};

		gpio0: gpio@3300 {
			compatible = "realtek,rtl9300-gpio";
			reg = <0x3300 0x1c>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <24>;
			gpio-bank-name = "gpio";
		};

		/* SPI-NOR controller (Linux rtl930x.dtsi spi@1200). Read-only driver; clock divider inherited from stock. */
		spi0: spi@1200 {
			compatible = "realtek,rtl8380-spi";
			reg = <0x1200 0x100>;
			#address-cells = <1>;
			#size-cells = <0>;

			flash@0 {
				compatible = "jedec,spi-nor";	/* Winbond EF4019, 32 MiB; also mapped at 0xb4000000 */
				reg = <0>;
				spi-max-frequency = <50000000>;	/* ignored by the driver (no divider control) */

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <1>;
					#size-cells = <1>;

					partition@0 {
						label = "LOADER";
						reg = <0x0 0xe0000>;
						read-only;
					};
					partition@e0000 {
						label = "BDINFO";
						reg = <0xe0000 0x10000>;
						read-only;
					};
					partition@f0000 {
						label = "SYSINFO";
						reg = <0xf0000 0x10000>;
						read-only;
					};
					partition@100000 {
						label = "JFFS2_CFG";
						reg = <0x100000 0x100000>;
						read-only;
					};
					partition@200000 {
						label = "JFFS2_LOG";
						reg = <0x200000 0x100000>;
						read-only;
					};
					partition@300000 {
						label = "RUNTIME1";
						reg = <0x300000 0xe80000>;
						read-only;
					};
					partition@1180000 {
						label = "RUNTIME2";
						reg = <0x1180000 0xe80000>;
						read-only;
					};
				};
			};
		};
	};

	/* Switch core register block (Linux rtl930x.dtsi switch@1b000000). */
	switchcore {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x1b000000 0x10000>;

		/* SFP I2C master 0: SCL0 = GPIO8, SDA0-7 = GPIO9-16, one SDA per cage.
		 * 100 kHz = SFF-8472 base rate (400 kHz optional per module; #32). */
		i2c@36c {
			compatible = "realtek,rtl9301-i2c";
			reg = <0x36c 0x14>;
			#address-cells = <1>;
			#size-cells = <0>;

			sfp_i2c0: i2c@0 { reg = <0>; clock-frequency = <100000>; };
			sfp_i2c1: i2c@1 { reg = <1>; clock-frequency = <100000>; };
			sfp_i2c2: i2c@2 { reg = <2>; clock-frequency = <100000>; };
			sfp_i2c3: i2c@3 { reg = <3>; clock-frequency = <100000>; };
			sfp_i2c4: i2c@4 { reg = <4>; clock-frequency = <100000>; };
			sfp_i2c5: i2c@5 { reg = <5>; clock-frequency = <100000>; };
			sfp_i2c6: i2c@6 { reg = <6>; clock-frequency = <100000>; };
			sfp_i2c7: i2c@7 { reg = <7>; clock-frequency = <100000>; };
		};
	};

	/* Bit-banged bus to the TCA9534A laser TX-disable expander (SDA GPIO23, SCL GPIO22).
	 * Expander pin N = cage N+1, active-high TX-disable; power-on = all inputs = lasers off. */
	i2c_exp: i2c-expander {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio0 23 0>;
		scl-gpios = <&gpio0 22 0>;
		i2c-gpio,delay-us = <2>;	/* same as the OpenWrt DTS */
		#address-cells = <1>;
		#size-cells = <0>;

		gpio_exp: gpio@38 {
			compatible = "nxp,pca9534";	/* TCA9534A: same register map */
			reg = <0x38>;
			gpio-controller;
			#gpio-cells = <2>;
			label = "laser";
		};
	};

	/* 3-position mode switch, one-hot active-low (stock rtk.ko decode, docs/hardware.md).
	 * Pin 17 reads low in every position so far (#8): reported as-is, not interpreted. */
	keys {
		compatible = "gpio-keys";

		mode-m1 {
			label = "M1";
			gpios = <&gpio0 17 1>;	/* GPIO_ACTIVE_LOW */
			linux,code = <256>;	/* BTN_0; button-gpio probe requires it */
		};
		mode-m2 {
			label = "M2";
			gpios = <&gpio0 18 1>;
			linux,code = <257>;	/* BTN_1 */
		};
		mode-m3 {
			label = "M3";
			gpios = <&gpio0 19 1>;
			linux,code = <258>;	/* BTN_2 */
		};
	};
};
