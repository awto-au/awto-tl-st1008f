# IRQ latency build (`./dev.py build-kernel --latency`, #73): merged after st1008f-v2.config.
# irqsoff = worst IRQs-off section; timerlat = timer IRQ + thread wake latency per CPU (in-kernel cyclictest).
# Tracer hooks on every local_irq_* cost cycles: not for nic-bench numbers.
CONFIG_IRQSOFF_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
