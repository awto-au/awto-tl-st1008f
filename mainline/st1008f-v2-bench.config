# Bench kernel (`./dev.py build-kernel --bench`, docs/PLAIN-KERNEL-TESTS.md): merged after st1008f-v2.config.
# Out-of-tree GDMA test modules (kmod/rtl9300_gdma, kmod/gdma_bench) need loadable modules + the dmaengine core.
CONFIG_MODULES=y
CONFIG_DMA_ENGINE=y
# perf report resolves symbols from /proc/kallsyms; sampling via cpu-clock (PERF_EVENTS is in the base config)
CONFIG_KALLSYMS_ALL=y
