/*
 * TP-Link TL-ST1008F v2.0 (RTL9303) on mainline rtl930x.dtsi (Linux v7.3).
 * Board facts + switch/NIC/PCS/SerDes nodes from OpenWrt rtl9303_tplink_tl-st1008f-v2.dts +
 * rtl930x.dtsi; they bind to the forward-ported OpenWrt drivers (openwrt/patches/300-08..10,
 * docs/MAINLINE-PORT.md). Cage N = lanN = switch port in SWITCH_PORT_SFP below.
 */
/dts-v1/;

#include "rtl930x.dtsi"

#include <dt-bindings/gpio/gpio.h>

/* OpenWrt dts/macros.dtsi LED set bits */
#define RTL93XX_LED_SET_10G	(1 << 0)
#define RTL93XX_LED_SET_2P5G	(1 << 3)
#define RTL93XX_LED_SET_1G	(1 << 5)
#define RTL93XX_LED_SET_100M	(1 << 7)
#define RTL93XX_LED_SET_10M	(1 << 8)
#define RTL93XX_LED_SET_LINK	(1 << 9)
#define RTL93XX_LED_SET_ACT	(1 << 11)

/* u = unit address (hex), p = switch port, l = lanN, s = SerDes, g = sfpN (OpenWrt SWITCH_PORT_SFP) */
#define SWITCH_PORT_SFP(u, p, l, s, g)			\
	port##p: port@##u {				\
		reg = <##p>;				\
		label = #l;				\
		led-set = <0>;				\
		pcs-handle = <&serdes##s 0>;		\
		phy-mode = "1000base-x";		\
		sfp = <&sfp##g>;			\
		managed = "in-band-status";		\
	};

/ {
	compatible = "tplink,tl-st1008f-v2", "realtek,rtl9302-soc";
	model = "TP-Link TL-ST1008F v2.0";

	/* board 3V3 rail (always on); named so spi-nor/pca953x get a real vcc-supply */
	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* DRAM 256-512 MiB is reached via OCP zone 3 at bus 0x20000000 (OpenWrt 300-02 remap,
	 * HIGHMEM); a HIGHMEM=n kernel drops the second range (#27). */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>,
		      <0x20000000 0x10000000>;
	};

	/* our U-Boot's boot-attempt record (bootsel.c); st1008f-bootok clears it via /dev/mem (#73) */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		bootrec@e000000 {
			reg = <0x0e000000 0x1000>;
			no-map;
		};
	};

	/* 64 KiB on-chip SRAM, bus address (OpenWrt 838x/839x dtsi use the KSEG0 VA 0x9f000000).
	 * Mapped by the PLR, re-mapped after the highmem remap (300-21). Whole-device gen_pool,
	 * no children: gen_pool_get(dev, NULL) as OpenWrt clk-rtl83xx. no-memory-wc: plain
	 * uncached (KSEG1); the 34Kc ioremap_wc would be uncached-accelerated (#103). */
	sram0: sram@1f000000 {
		compatible = "mmio-sram";
		reg = <0x1f000000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0x1f000000 0x10000>;
		no-memory-wc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon";
	};

	/* M1/M2/M3 switch, read raw like stock rtk.ko (openwrt/patches/300-06, #64).
	 * Replaces OpenWrt's gpio-keys on the same pins (one owner per pin).
	 * Children are cage@N, never port@N: rtl83xx walks every "port" node in the tree. */
	mode-switch {
		compatible = "tplink,st1008f-mode-switch";
		gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>, <&gpio0 18 GPIO_ACTIVE_HIGH>,
			<&gpio0 19 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;

		cage@0 {
			reg = <0>;
			sfp = <&sfp0>;
		};
		cage@1 {
			reg = <1>;
			sfp = <&sfp1>;
		};
		cage@2 {
			reg = <2>;
			sfp = <&sfp2>;
		};
		cage@3 {
			reg = <3>;
			sfp = <&sfp3>;
		};
		cage@4 {
			reg = <4>;
			sfp = <&sfp4>;
		};
		cage@5 {
			reg = <5>;
			sfp = <&sfp5>;
		};
		cage@6 {
			reg = <6>;
			sfp = <&sfp6>;
		};
		cage@7 {
			reg = <7>;
			sfp = <&sfp7>;
		};
	};

	/* TX-disable expander; SCL = GPIO22, SDA = GPIO23. */
	i2c-expander {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-gpio,delay-us = <2>;
		scl-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;

		gpioexp0: gpio@38 {
			compatible = "nxp,pca9534";
			vcc-supply = <&reg_3v3>;
			reg = <0x38>;
			gpio-controller;
			#gpio-cells = <2>;
		};
	};

	/* Cage N+1: MOD-DEF0 = GPIO N (active-low), TX-disable = expander pin N (active-high).
	 * Power: every cage 2000 mW (SFF-8472 max level); OpenWrt's 2.9/1.5/2.0 W split is copied, not measured (#30). */
	sfp0: sfp-p1 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_0>;
		mod-def0-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 0 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp1: sfp-p2 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_1>;
		mod-def0-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 1 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp2: sfp-p3 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_2>;
		mod-def0-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 2 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp3: sfp-p4 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_3>;
		mod-def0-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 3 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp4: sfp-p5 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_4>;
		mod-def0-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 4 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp5: sfp-p6 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_5>;
		mod-def0-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 5 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp6: sfp-p7 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_6>;
		mod-def0-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 6 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	sfp7: sfp-p8 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0_7>;
		mod-def0-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpioexp0 7 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <2000>;
	};

	/* GPIO21: stock rtk.ko switch_reset() drives it low = board reset.
	 * gpio-wdt probe drives it low too -> instant reset on 7.3. Disabled until the line is understood (#18). */
	watchdog-ext {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		hw_algo = "toggle";
		hw_margin_ms = <1200>;
		always-running;
		status = "disabled";
	};
};

/* SMP (#73, #16): intc outputs as OpenWrt rtl930x.dtsi. Mainline routes all to output 0 = IP2, which
 * vsmp_init_secondary() leaves masked on VPE1 (only IP0/1/6/7) -> CPU1 timer never ticks, boot hangs.
 * Per-CPU timers on output 4 = IP6; IP7 (CP0 timer/perf) is not claimed. Cell 2 = output index. */
&intc {
	#interrupt-cells = <2>;
	interrupts = <2>, <3>, <4>, <5>, <6>;
};

&switch0 {
	interrupts = <23 2>, <24 3>;
};

&timer0 {
	interrupts = <7 4>, <8 4>, <9 4>, <10 4>, <11 4>;
};

&watchdog0 {
	interrupts = <5 4>, <6 4>;
};

&gpio0 {
	interrupts = <13 1>;
};

&snand {
	interrupts = <19 2>;
};

&uart0 {
	interrupts = <30 1>;
	status = "okay";
};

&uart1 {
	interrupts = <31 0>;
};

/* SPI_CTRL1 pinmux, as OpenWrt rtl930x.dtsi (mainline dtsi lacks it). Stock U-Boot muxes GPIO3-5
 * (cage 4-6 MOD-DEF0) to the unused switch-core SPI master: empty cages read "present" (#29). */
/ {
	pinmux@1b0003a0 {
		compatible = "pinctrl-single";
		reg = <0x1b0003a0 0x4>;
		pinctrl-single,bit-per-mux;
		pinctrl-single,register-width = <32>;
		pinctrl-single,function-mask = <0x1>;
		#pinctrl-cells = <2>;

		/* GPIO3-5 = GPIO */
		pinmux_disable_spi0: disable-spi0 {
			pinctrl-single,bits = <0x0 0x0 0x2000>;
		};
		/* GPIO6 = GPIO (cage 7 MOD-DEF0) */
		pinmux_disable_spi0_cs1: disable-spi-cs1 {
			pinctrl-single,bits = <0x0 0x0 0x800>;
		};
		/* GPIO7 = GPIO (cage 8 MOD-DEF0) */
		pinmux_disable_spi0_cs0: disable-spi-cs0 {
			pinctrl-single,bits = <0x0 0x0 0x400>;
		};
	};
};

/* GPIO0-7 = cage MOD-DEF0: take them back from the SPI master before any sfp probes (#29) */
&gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_disable_spi0>, <&pinmux_disable_spi0_cs1>, <&pinmux_disable_spi0_cs0>;
};

/* Port LED pattern, read by the rtl83xx DSA driver (led-set per port) */
/ {
	led_set {
		compatible = "realtek,rtl9300-leds";
		active-high;

		led_set0 = <(RTL93XX_LED_SET_1G | RTL93XX_LED_SET_100M | RTL93XX_LED_SET_10M |
			     RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_2P5G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_10G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)>;
	};

	thermal-zones {
		cpu-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			/* Realtek SDK dal_longan_switch_thermalTemp_get: TEMP_OUT * 1.29 - 10 degC (#13) */
			coefficients = <1290 (-10000)>;
			thermal-sensors = <&soc_thermal>;
			trips {
				critical {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
	};
};

/* rtl9301-switch + otto-switch: rtl83xx DSA driver; otto-* children: OpenWrt drivers (300-09/10) */
&switch0 {
	compatible = "realtek,rtl9303-switch", "realtek,rtl9301-switch", "realtek,otto-switch",
		     "syscon", "simple-mfd";

	ethernet0: ethernet {
		compatible = "realtek,rtl9301-eth";
		interrupt-parent = <&intc>;
		interrupts = <24 3>;
		phy-mode = "internal";
		sram = <&sram0>;	/* rings here with rtl838x_eth.sram_rings=1 (300-25, #103) */
		nvmem-cells = <&macaddr_uboot 0>;
		nvmem-cell-names = "mac-address";

		fixed-link {
			speed = <1000>;
			full-duplex;
		};
	};

	mdio_serdes: mdio-serdes {
		compatible = "realtek,rtl9301-serdes-mdio";
	};

	pcs {
		compatible = "realtek,rtl9301-pcs", "realtek,otto-pcs";
		#address-cells = <1>;
		#size-cells = <0>;
		mdio-parent-bus = <&mdio_serdes>;

		serdes0: serdes@0 { reg = <0>; #pcs-cells = <1>; };
		serdes1: serdes@1 { reg = <1>; #pcs-cells = <1>; };
		serdes2: serdes@2 { reg = <2>; #pcs-cells = <1>; };
		serdes3: serdes@3 { reg = <3>; #pcs-cells = <1>; };
		serdes4: serdes@4 { reg = <4>; #pcs-cells = <1>; };
		serdes5: serdes@5 { reg = <5>; #pcs-cells = <1>; };
		serdes6: serdes@6 { reg = <6>; #pcs-cells = <1>; };
		serdes7: serdes@7 { reg = <7>; #pcs-cells = <1>; };
		serdes8: serdes@8 { reg = <8>; #pcs-cells = <1>; };
		serdes9: serdes@9 { reg = <9>; #pcs-cells = <1>; };
		serdes10: serdes@a { reg = <10>; #pcs-cells = <1>; };
		serdes11: serdes@b { reg = <11>; #pcs-cells = <1>; };
	};

	table {
		compatible = "realtek,rtl9301-table", "realtek,otto-table";
	};

	soc_thermal: thermal {
		compatible = "realtek,rtl9300-thermal";
		#thermal-sensor-cells = <0>;
	};

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		SWITCH_PORT_SFP(0, 0, lan1, 2, 0)
		SWITCH_PORT_SFP(8, 8, lan2, 3, 1)
		SWITCH_PORT_SFP(10, 16, lan3, 4, 2)
		SWITCH_PORT_SFP(14, 20, lan4, 5, 3)
		SWITCH_PORT_SFP(18, 24, lan5, 6, 4)
		SWITCH_PORT_SFP(19, 25, lan6, 7, 5)
		SWITCH_PORT_SFP(1a, 26, lan7, 8, 6)
		SWITCH_PORT_SFP(1b, 27, lan8, 9, 7)

		port@1c {
			reg = <28>;
			ethernet = <&ethernet0>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};

/* No MDIO PHYs on this board (SFP only); the DSA driver still waits for every bus to register. */
&mdio_controller {
	compatible = "realtek,rtl9301-mdio", "realtek,otto-mdio";
	status = "okay";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
};

&mdio2 {
	status = "okay";
};

&mdio3 {
	status = "okay";
};

/* SCL0 = GPIO8, SDA0-7 = GPIO9-16, one SDA per cage. */
&i2c0 {
	compatible = "realtek,rtl9303-i2c", "realtek,rtl9301-i2c";
	realtek,scl = <0>;
	status = "okay";

	i2c0_0: i2c@0 {
		reg = <0>;
	};
	i2c0_1: i2c@1 {
		reg = <1>;
	};
	i2c0_2: i2c@2 {
		reg = <2>;
	};
	i2c0_3: i2c@3 {
		reg = <3>;
	};
	i2c0_4: i2c@4 {
		reg = <4>;
	};
	i2c0_5: i2c@5 {
		reg = <5>;
	};
	i2c0_6: i2c@6 {
		reg = <6>;
	};
	i2c0_7: i2c@7 {
		reg = <7>;
	};
};

/* Flash read window 0x14000000 (32 MiB) for spi0 dirmap reads (openwrt/patches/300-07, #61) */
&soc {
	ranges = <0x0 0x18000000 0x20000>, <0x14000000 0x14000000 0x2000000>;
};

&spi0 {
	reg = <0x1200 0x100>, <0x14000000 0x2000000>;
	reg-names = "regs", "dirmap";
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		vcc-supply = <&reg_3v3>;
		reg = <0>;
		spi-max-frequency = <100000000>;

		/* all read-only: no flash writes from this kernel (CLAUDE.md hazards) */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0xe0000>;
				read-only;
			};

			partition@e0000 {
				label = "u-boot-env";
				reg = <0xe0000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "u-boot,env";

					macaddr_uboot: ethaddr {
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@f0000 {
				label = "u-boot-env2";
				reg = <0xf0000 0x10000>;
				read-only;
			};

			partition@100000 {
				label = "jffs2-cfg";
				reg = <0x100000 0x100000>;
				read-only;
			};

			partition@200000 {
				label = "jffs2-log";
				reg = <0x200000 0xf0000>;
				read-only;
			};

			/* A/B layout as the OpenWrt DTS (#117); read-only here */
			partition@2f0000 {
				label = "bootstate";
				reg = <0x2f0000 0x10000>;
				read-only;
			};

			partition@300000 {
				label = "firmware_a";
				reg = <0x300000 0xe80000>;
				read-only;
			};

			partition@1180000 {
				label = "firmware_b";
				reg = <0x1180000 0xe80000>;
				read-only;
			};
		};
	};
};
