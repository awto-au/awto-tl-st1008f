# nf_tables expressions of the OpenWrt image (kmod-nft-core / -fib / -offload / nf-log, built in there) that the fw4 ruleset
# (mainline/fw4-b.nft) needs; merged after st1008f-v2-clean.config by `--owrt-userland` (NAT-STACK-TESTS.md)
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
