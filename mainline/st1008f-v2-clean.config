# Clean profile (`./dev.py build-kernel --bench --clean`, docs/NAT-STACK-TESTS.md): merged after the bench fragment.
# Goal: numbers kernel = no tracing/profiling, option set aligned to the OpenWrt 7.4 image (B). Profile build = without this file.
# --- tracing / profiling off (st1008f-v2.config turns them on for diagnosis)
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_HW_PERF_EVENTS is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_UPROBES is not set
# CONFIG_KALLSYMS_ALL is not set
# --- timer / hardening / memory, as OpenWrt
# CONFIG_HZ_250 is not set
CONFIG_HZ_100=y
CONFIG_STACKPROTECTOR=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_SLAB_BUCKETS=y
# --- routing / qdisc / TCP, as OpenWrt (policy routing adds fib_rules lookups; fq_codel is the eth0 default qdisc)
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_MULTICAST=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
# --- netfilter, as OpenWrt (conntrack zones/timeout/mark/procfs; no egress hook)
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_PROCFS=y
# CONFIG_NETFILTER_EGRESS is not set
# --- cgroups / memcg / namespaces, as OpenWrt (memcg charges skb and slab allocations)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
