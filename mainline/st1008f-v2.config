# Kconfig fragment on top of 32r2_defconfig (+ big-endian) for the ST1008F v2, mainline Linux v7.3
CONFIG_CPU_BIG_ENDIAN=y
CONFIG_MACH_REALTEK_RTL=y
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_REALTEK_OTTO=y
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_WATCHDOG=y
CONFIG_WATCHDOG=y
CONFIG_REALTEK_OTTO_WDT=y
CONFIG_I2C=y
CONFIG_I2C_RTL9300=y
CONFIG_I2C_GPIO=y
CONFIG_SPI=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_OF_PARTS=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_NETDEVICES=y
CONFIG_PHYLIB=y
CONFIG_SFP=y
CONFIG_MDIO_REALTEK_RTL9300=y
CONFIG_DEBUG_FS=y
CONFIG_MIPS_PLATFORM_DEVICES=y
CONFIG_TPLINK_ST1008F_MODE_SWITCH=y
