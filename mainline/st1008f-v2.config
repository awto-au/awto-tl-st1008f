# Complete Kconfig for the ST1008F v2, mainline Linux v7.3, on top of `allnoconfig` (#16).
# Every line here must survive olddefconfig; scripts/mainline_build_check.py fails and lists any that drop.
# CONFIG_INITRAMFS_SOURCE comes from scripts/mainline_initramfs.py (generated fragment).

# --- SoC / CPU: RTL9303, MIPS 34Kc, big-endian; MT SMP = both VPEs (owner decision, #16; --up for A/B)
CONFIG_MACH_REALTEK_RTL=y
# SoC family (OpenWrt 300-01): selects MIPS_CPU_SCACHE, needed by REALTEK_THERMAL
CONFIG_RTL930X=y
CONFIG_32BIT=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_CPU_BIG_ENDIAN=y
# 34Kc has no FPU: kernel FP emulation for userspace
CONFIG_MIPS_FP_SUPPORT=y
# OpenWrt 300-02 maps DRAM above 256 MiB as highmem
CONFIG_HIGHMEM=y
CONFIG_SMP=y
CONFIG_MIPS_MT_SMP=y
CONFIG_NR_CPUS=2
CONFIG_RPS=y
CONFIG_XPS=y
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_MIPS_RAW_APPENDED_DTB=y
# DT bootargs + U-Boot bootargs (ramload --bootargs, e.g. memtest=4, #103)
CONFIG_MIPS_CMDLINE_DTB_EXTEND=y
# early pattern test of lowmem with memtest=N (MIPS: highmem not covered, #103)
CONFIG_MEMTEST=y

# --- core + what BusyBox needs
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
# BusyBox 1.31 (musl 1.1, pre-time64) calls clock_gettime/nanosleep with 32-bit time_t
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEBUG_FS=y
# /dev/mem for BusyBox devmem: switch registers from scripts (drop-counters, #74)
CONFIG_DEVMEM=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# console daemon break_cmd = BREAK + SysRq byte
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y

# --- console: 8250 UART from DT, earlycon
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_EARLY_PRINTK=y

# --- GPIO, I2C, mode switch (OpenWrt 300-06)
CONFIG_GPIOLIB=y
CONFIG_GPIO_REALTEK_OTTO=y
# SPI_CTRL1 pinmux node: frees cage MOD-DEF0 GPIO3-7 from the switch-core SPI master (#29)
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIO_PCA953X=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RTL9300=y
CONFIG_I2C_GPIO=y
# switchcore syscon regmap: i2c-rtl9300 and mdio-realtek-rtl9300 (syscon_node_to_regmap)
CONFIG_MFD_SYSCON=y
CONFIG_MIPS_PLATFORM_DEVICES=y
CONFIG_TPLINK_ST1008F_MODE_SWITCH=y
# port LED patterns: panic_blink, error latch, boot-pattern release (300-16, #9)
CONFIG_TPLINK_ST1008F_LEDS=y

# --- watchdog (gpio-wdt node is disabled in the DTS: GPIO21 low = board reset)
CONFIG_WATCHDOG=y
CONFIG_REALTEK_OTTO_WDT=y
CONFIG_GPIO_WATCHDOG=y

# --- SPI-NOR (driver: obj-$(CONFIG_MACH_REALTEK_RTL); dirmap reads, openwrt/patches/300-07)
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_OF_PARTS=y
# eth0 MAC from the U-Boot env `ethaddr` (DTS nvmem-layout on u-boot-env)
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_NVMEM_LAYOUT_U_BOOT_ENV=y

# --- network core (#16)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y

# --- switch: OpenWrt realtek drivers forward-ported (openwrt/patches/300-08..10, docs/MAINLINE-PORT.md)
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_NET_RTL838X=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_RTL83XX=y
CONFIG_NET_DSA_TAG_RTL_OTTO=y
CONFIG_REALTEK_OTTO_TABLE=y
CONFIG_PCS_RTL_OTTO=y
CONFIG_FWNODE_PCS=y
CONFIG_MDIO_REALTEK_OTTO=y
CONFIG_MDIO_REALTEK_OTTO_SERDES=y
# OpenWrt's mdio-realtek-otto binds realtek,rtl9301-mdio instead (the DSA driver needs it)
# CONFIG_MDIO_REALTEK_RTL9300 is not set
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_SFP=y
# SMBus-only i2c-rtl9300: PHY access in copper SFPs (OpenWrt 712/714)
# I2C_SMBUS is only user-visible without I2C_HELPER_AUTO; MDIO_SMBUS depends on it
# CONFIG_I2C_HELPER_AUTO is not set
CONFIG_I2C_SMBUS=y
CONFIG_MDIO_SMBUS=y
# GLC-T copper SFPs (88E1111), cages 3 and 7
CONFIG_MARVELL_PHY=y

# --- NAT / routing / flow offload test kernel (#16)
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
# nat_bench.py rxdrop: netdev ingress drop table
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
# nat_bench.py pktgen (TX-only driver cost)
CONFIG_NET_PKTGEN=y

# --- profiling the CPU-port NIC path (#65): 34K hardware counters, function/graph tracer
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# --- SoC thermal sensor (OpenWrt 330)
# on-chip SRAM: mmio-sram gen_pool (300-21 keeps it mapped) + latency bench in debugfs (300-22, #103)
CONFIG_SRAM=y
CONFIG_ST1008F_SRAM_BENCH=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_REALTEK_THERMAL=y

# --- off on purpose (EXPERT exposes the ones allnoconfig leaves at default y)
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_IO_URING is not set
# CONFIG_NAMESPACES is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
