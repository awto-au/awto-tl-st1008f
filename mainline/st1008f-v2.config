# Complete Kconfig for the ST1008F v2, mainline Linux v7.3, on top of `allnoconfig` (#16).
# Every line here must survive olddefconfig; scripts/mainline_build_check.py fails and lists any that drop.
# CONFIG_INITRAMFS_SOURCE comes from scripts/mainline_initramfs.py (generated fragment).

# --- SoC / CPU: RTL9303, MIPS 34Kc, big-endian, uniprocessor (MT SMP not enabled yet)
CONFIG_MACH_REALTEK_RTL=y
CONFIG_32BIT=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_CPU_BIG_ENDIAN=y
# 34Kc has no FPU: kernel FP emulation for userspace
CONFIG_MIPS_FP_SUPPORT=y
# OpenWrt 300-02 maps DRAM above 256 MiB as highmem
CONFIG_HIGHMEM=y
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_MIPS_CMDLINE_FROM_DTB=y

# --- core + what BusyBox needs
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# console daemon break_cmd = BREAK + SysRq byte
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y

# --- console: 8250 UART from DT, earlycon
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_EARLY_PRINTK=y

# --- GPIO, I2C, mode switch (OpenWrt 300-06)
CONFIG_GPIOLIB=y
CONFIG_GPIO_REALTEK_OTTO=y
CONFIG_GPIO_PCA953X=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RTL9300=y
CONFIG_I2C_GPIO=y
# switchcore syscon regmap: i2c-rtl9300 and mdio-realtek-rtl9300 (syscon_node_to_regmap)
CONFIG_MFD_SYSCON=y
CONFIG_MIPS_PLATFORM_DEVICES=y
CONFIG_TPLINK_ST1008F_MODE_SWITCH=y

# --- watchdog (gpio-wdt node is disabled in the DTS: GPIO21 low = board reset)
CONFIG_WATCHDOG=y
CONFIG_REALTEK_OTTO_WDT=y
CONFIG_GPIO_WATCHDOG=y

# --- SPI-NOR (driver: obj-$(CONFIG_MACH_REALTEK_RTL); dirmap reads, openwrt/patches/300-07)
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_OF_PARTS=y

# --- network: base stack for the later DSA port (#16); no DSA until drivers exist
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_PHYLIB=y
CONFIG_SFP=y
CONFIG_MDIO_REALTEK_RTL9300=y

# --- off on purpose (EXPERT exposes the ones allnoconfig leaves at default y)
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_ETHERNET is not set
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_IO_URING is not set
# CONFIG_NAMESPACES is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
