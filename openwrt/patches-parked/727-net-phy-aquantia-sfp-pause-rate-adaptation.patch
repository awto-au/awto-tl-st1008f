From: Dan <dan@awto.au>
Subject: [PATCH] net: phy: aquantia: pause rate adaptation for SFP XFI hosts

SFP modules (e.g. FS SFP-10G-T, AQR113C, RollBall) run the host side as
XFI. A sub-10G global system configuration word that selects XFI without
rate adaptation cannot carry traffic at that media speed. Switch such
words to pause rate adaptation, with the PHY in low power, before the
words are parsed into possible_interfaces. Log all six words once per
attach so the module provisioning is visible in dmesg.

Applies after hack-6.18/726. OpenWrt path:
target/linux/generic/hack-6.18/727-net-phy-aquantia-sfp-pause-rate-adaptation.patch
---
diff --git a/drivers/net/phy/aquantia/aquantia_main.c b/drivers/net/phy/aquantia/aquantia_main.c
index d286e76..749eca5 100644
--- a/drivers/net/phy/aquantia/aquantia_main.c
+++ b/drivers/net/phy/aquantia/aquantia_main.c
@@ -1090,6 +1090,74 @@ static int aqr_gen2_provision_usxgmii(struct phy_device *phydev)
 	return aqr_gen1_wait_processor_intensive_op(phydev);
 }
 
+/* SFP modules with an XFI host side: a sub-10G speed word of XFI without rate
+ * adaptation cannot pass traffic, so switch it to pause rate adaptation.
+ */
+static int aqr_gen2_provision_sfp_rate_adapt(struct phy_device *phydev)
+{
+	u16 cfg[AQR_NUM_GLOBAL_CFG];
+	bool fix = false;
+	int i, val, ret;
+
+	if (!phy_on_sfp(phydev) ||
+	    phydev->interface != PHY_INTERFACE_MODE_10GBASER)
+		return 0;
+
+	for (i = 0; i < AQR_NUM_GLOBAL_CFG; i++) {
+		val = phy_read_mmd(phydev, MDIO_MMD_VEND1,
+				   aqr_global_cfg_regs[i].reg);
+		if (val < 0)
+			return val;
+
+		cfg[i] = val;
+		if (aqr_global_cfg_regs[i].speed < SPEED_10000 &&
+		    FIELD_GET(VEND1_GLOBAL_CFG_SERDES_MODE, val) ==
+		    VEND1_GLOBAL_CFG_SERDES_MODE_XFI &&
+		    FIELD_GET(VEND1_GLOBAL_CFG_RATE_ADAPT, val) ==
+		    VEND1_GLOBAL_CFG_RATE_ADAPT_NONE)
+			fix = true;
+	}
+
+	phydev_info(phydev,
+		    "global cfg 10M %04x 100M %04x 1G %04x 2.5G %04x 5G %04x 10G %04x%s\n",
+		    cfg[0], cfg[1], cfg[2], cfg[3], cfg[4], cfg[5],
+		    fix ? ", adding pause rate adaptation" : "");
+	if (!fix)
+		return 0;
+
+	ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, MDIO_CTRL1,
+			       MDIO_CTRL1_LPOWER);
+	if (ret)
+		return ret;
+
+	ret = aqr_gen1_wait_processor_intensive_op(phydev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < AQR_NUM_GLOBAL_CFG; i++) {
+		if (aqr_global_cfg_regs[i].speed >= SPEED_10000 ||
+		    FIELD_GET(VEND1_GLOBAL_CFG_SERDES_MODE, cfg[i]) !=
+		    VEND1_GLOBAL_CFG_SERDES_MODE_XFI ||
+		    FIELD_GET(VEND1_GLOBAL_CFG_RATE_ADAPT, cfg[i]) !=
+		    VEND1_GLOBAL_CFG_RATE_ADAPT_NONE)
+			continue;
+
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
+				    aqr_global_cfg_regs[i].reg,
+				    cfg[i] | FIELD_PREP(VEND1_GLOBAL_CFG_RATE_ADAPT,
+							VEND1_GLOBAL_CFG_RATE_ADAPT_PAUSE));
+		if (ret)
+			return ret;
+	}
+
+	ret = phy_clear_bits_mmd(phydev, MDIO_MMD_VEND1, MDIO_CTRL1,
+				 MDIO_CTRL1_LPOWER);
+	if (ret)
+		return ret;
+
+	return aqr_gen1_wait_processor_intensive_op(phydev);
+}
+
 static int aqr_gen2_fill_interface_modes(struct phy_device *phydev)
 {
 	unsigned long *possible = phydev->possible_interfaces;
@@ -1115,6 +1183,10 @@ static int aqr_gen2_fill_interface_modes(struct phy_device *phydev)
 	if (ret)
 		return ret;
 
+	ret = aqr_gen2_provision_sfp_rate_adapt(phydev);
+	if (ret)
+		return ret;
+
 	ret = aqr_gen2_read_global_syscfg(phydev);
 	if (ret)
 		return ret;
