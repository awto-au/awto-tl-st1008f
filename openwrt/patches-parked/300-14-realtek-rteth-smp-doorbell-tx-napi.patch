 /*
- * RTL930x: TX_*_FETCH self-clear and no other bit changes while the queues run (SDK
- * r9300_nicTxFetch_set: plain field write, no poll), so one MMIO write of the cached value.
+ * RTL930x: TX_*_FETCH self-clear and no other bit changes while the queues run, so one MMIO
+ * write of the cached value. Set both rings' fetch bits: writing 0 to the other ring's bit
+ * (another CPU's pending kick) is not documented as harmless; an extra fetch of a ring with no
+ * OWN descriptor is (SDK r9300_nicTxFetch_set RMW also writes back a pending 1). Lockless, SMP-safe.
  */
 static void rteth_930x_tx_kick(struct rteth_ctrl *ctrl, int ring)
 {
-	writel_relaxed(ctrl->dma_if_ctrl_val | RTETH_TX_TRIGGER(ctrl, ring),
+	writel_relaxed(ctrl->dma_if_ctrl_val | ctrl->cfg->tx_trigger_mask,
 		       ctrl->base + ctrl->cfg->dma_if_ctrl);
 }
 
