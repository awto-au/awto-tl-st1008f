Subject: realtek: rteth (rtl838x_eth) SMP: both-ring RTL930x doorbell, optional TX completion NAPI on another CPU (#60 #16)

- RTL930x doorbell sets both TX_*_FETCH bits: the 300-12 single write put 0 in the other ring's
  fetch bit, which may cancel that ring's pending kick (from another CPU, or not yet taken by the
  NIC); an extra fetch of a ring without OWN descriptors is a no-op. Still one lockless writel.
- tx_cpu module param (/sys/module/rtl838x_eth/parameters/tx_cpu, default -1 = 300-12 inline
  reclaim): N >= 0 moves TX reclaim + skb free to a per-ring TX NAPI scheduled on CPU N by IPI;
  RX poll then skips reclaim, a full ring stops the queue for the TX NAPI to wake.
- Measured: docs/NAT.md "SMP", #60.
---
--- a/drivers/net/ethernet/realtek/rtl838x_eth.c
+++ b/drivers/net/ethernet/realtek/rtl838x_eth.c
@@ -652,6 +652,58 @@
 		netif_tx_wake_queue(txq);
 }
 
+/* -1: TX reclaim inline (xmit + RX poll). N: per-ring TX NAPI scheduled on CPU N by IPI. */
+static int tx_cpu = -1;
+module_param(tx_cpu, int, 0644);
+MODULE_PARM_DESC(tx_cpu, "CPU for TX completion NAPI, -1 = inline in xmit/RX poll");
+
+static int rteth_tx_cpu(void)
+{
+	int cpu = READ_ONCE(tx_cpu);
+
+	return cpu >= 0 && cpu_online(cpu) ? cpu : -1;
+}
+
+static void rteth_tx_csd_func(void *info)
+{
+	napi_schedule(info);
+}
+
+static void rteth_tx_napi_kick(struct rteth_ctrl *ctrl, int r, int cpu)
+{
+	smp_mb(); /* send_count update before the SCHED test; pairs with rteth_poll_tx */
+	if (test_bit(NAPI_STATE_SCHED, &ctrl->tx_napi[r].state))
+		return;
+	if (cpu == smp_processor_id())
+		napi_schedule(&ctrl->tx_napi[r]);
+	else
+		smp_call_function_single_async(cpu, &ctrl->tx_csd[r]); /* -EBUSY: already queued */
+}
+
+static int rteth_poll_tx(struct napi_struct *napi, int budget)
+{
+	struct rteth_ctrl *ctrl = netdev_priv(napi->dev);
+	int r = napi - ctrl->tx_napi;
+	struct netdev_queue *txq = netdev_get_tx_queue(ctrl->dev, r);
+	bool pending;
+
+	__netif_tx_lock(txq, smp_processor_id());
+	rteth_reclaim_tx_ring(ctrl, r, budget);
+	pending = ctrl->tx_info[r].send_count != ctrl->tx_info[r].clean_count;
+	__netif_tx_unlock(txq);
+
+	/* no TX-done IRQ: keep polling while the hardware owns frames */
+	if (pending)
+		return budget;
+	/* xmit skips the IPI while SCHED is set: recheck after clearing it */
+	if (napi_complete(napi)) {
+		smp_mb();
+		if (READ_ONCE(ctrl->tx_info[r].send_count) != READ_ONCE(ctrl->tx_info[r].clean_count))
+			napi_schedule(napi);
+	}
+	return 0;
+}
+
 /* True while a TX queue is stopped with frames still owned by the hardware: there is no
  * TX-done interrupt, so the RX NAPI poll keeps polling until they drain.
  */
@@ -834,6 +886,8 @@
 {
 	for (int i = 0; i < RTETH_RX_RINGS; i++)
 		napi_enable(&ctrl->rx_info[i].napi);
+	for (int r = 0; r < RTETH_TX_RINGS; r++)
+		napi_enable(&ctrl->tx_napi[r]);
 	ctrl->napi_enabled = true;
 }
 
@@ -845,6 +899,8 @@
 	ctrl->napi_enabled = false;
 	for (int i = 0; i < RTETH_RX_RINGS; i++)
 		napi_disable(&ctrl->rx_info[i].napi);
+	for (int r = 0; r < RTETH_TX_RINGS; r++)
+		napi_disable(&ctrl->tx_napi[r]);
 }
 
 static int rteth_open(struct net_device *dev)
