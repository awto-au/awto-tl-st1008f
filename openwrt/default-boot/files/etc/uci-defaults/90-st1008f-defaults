#!/bin/sh
# ST1008F default config (#73, docs/DEFAULT-BOOT.md "Config"). Runs in /etc/init.d/boot (START=10),
# before st1008f-mode (19) and network (20): the bridge is created with STP on (cage loop #19).
# Tmpfs root (recovery image): runs every boot.

# Management L3 device = lan's device from 02_network (`switch.1`); aliases bind to it directly,
# not `@lan`: an alias on a DHCP interface stays down until a lease arrives.
dev=$(uci -q get network.lan.device)
[ -n "$dev" ] || dev=switch.1

uci -q batch <<EOF
set network.switch.stp='1'
set network.switch.forward_delay='2'
set network.lan.proto='dhcp'
delete network.lan.ipaddr
delete network.lan.netmask
delete network.lan.gateway
delete network.lan.dns
delete network.lan.ip6assign
set network.lan_fb=interface
set network.lan_fb.device='$dev'
set network.lan_fb.proto='static'
set network.lan_fb.ipaddr='192.168.0.1'
set network.lan_fb.netmask='255.255.255.0'
set network.lan6=interface
set network.lan6.device='$dev'
set network.lan6.proto='dhcpv6'
set network.lan6.reqprefix='no'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ndp='disabled'
commit network
commit dhcp
EOF

# lan_fb and lan6 in the lan zone (fw4 input accept); del_list first = idempotent
for z in $(uci show firewall | sed -n "s/^\(firewall\.[^.]*\)\.name='lan'$/\1/p"); do
	for n in lan_fb lan6; do
		uci -q del_list "$z.network=$n"
		uci add_list "$z.network=$n"
	done
done
uci commit firewall
exit 0
