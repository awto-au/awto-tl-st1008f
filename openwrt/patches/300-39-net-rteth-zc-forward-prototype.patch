+
 	spin_lock(&ctrl->rx_lock);
 	ctrl->cfg->update_counter(ctrl, ring, work_done);
 	dev->stats.rx_packets += rx_packets;
@@ -1481,6 +1625,7 @@
 
 	for (int r = 0; r < RTETH_RX_RINGS; r++)
 		seq_printf(m, "ring%d_frames %lu\n", r, READ_ONCE(ctrl->rx_info[r].pkts));
+	seq_printf(m, "zc_fwd %lu\nzc_miss %lu\nzc_busy %lu\n", zc_fwd, zc_miss, zc_busy);
 	for (int i = 0; i < ARRAY_SIZE(rteth_rxq_fields); i++) {
 		regmap_read(ctrl->map, rteth_rxq_fields[i].reg, &v);
 		seq_printf(m, "%s %u\n", rteth_rxq_fields[i].name, (v >> rteth_rxq_fields[i].shift) & 0x1f);
