+
+	__netif_tx_lock(txq, smp_processor_id());
+	txslot = txi->send_count & (RTETH_TX_RING_SIZE - 1);
+	packet_dma = ctrl->tx_data[0].ring[txslot];
+	if (unlikely(packet_dma & RTETH_RING_OWN_HW)) {
+		__netif_tx_unlock(txq);
+		zc_busy++;
+		return false;
+	}
+	if (unlikely(txi->skb[txslot]))
+		rteth_reclaim_tx_ring(ctrl, 0, 1);
+	tf = &ctrl->tx_data[0].frag[txslot];
+	txi->skb[txslot] = RTETH_ZC_MARK;
+	txi->zc_page[txslot] = page;
+	txi->zc_pool[txslot] = rxi->pool;
+	tf->len = len;	/* RX len = frame + 4 FCS bytes; TX takes frame + 4 bytes of FCS room, as the skb path does */
+	tf->dma = dma;
+	ctrl->cfg->create_tx_header(tf, port, 0);
+	if (zc_dbg && len > 1000) {
+		zc_dbg--;
+		pr_info("tx zc:    len %u rxlen %u port %d flow %d tag %*ph data %*ph\n", tf->len, frag->len, port, !!z, 20,
+			tf->cpu_tag, 32, p);
+	}
+	dma_wmb();
+	ctrl->tx_data[0].ring[txslot] = packet_dma | RTETH_RING_OWN_HW;
+	txi->send_count++;
+	wmb();
+	if (txi->send_count - txi->kick_count >= RTETH_TX_KICK_BATCH) {
+		ctrl->cfg->tx_kick(ctrl, 0);
+		txi->kick_count = txi->send_count;
+	}
+	__netif_tx_unlock(txq);
+	zc_fwd++;
+	if (z)
+		zc_hw++;
+	return true;
+
+miss:
+	if (zc_miss++ < 3)	/* first misses: the real frame layout (VLAN tag? ethertype?) */
+		print_hex_dump(KERN_INFO, "zc miss: ", DUMP_PREFIX_OFFSET, 16, 1, p, min(len, 48u), false);
+	return false;
+}
+
+static void rteth_zc_kick(struct rteth_ctrl *ctrl)
+{
+	struct netdev_queue *txq = netdev_get_tx_queue(ctrl->dev, 0);
+	struct rteth_tx_info *txi = &ctrl->tx_info[0];
+
+	if (txi->kick_count == txi->send_count)
+		return;
+	__netif_tx_lock(txq, smp_processor_id());
+	ctrl->cfg->tx_kick(ctrl, 0);
+	txi->kick_count = txi->send_count;
+	__netif_tx_unlock(txq);
+}
