From: Dan <dan@awto.au>
Subject: [PATCH] net: rteth: in-place UDP forward without an skb, behind a module parameter (#148 prototype)

- zc=1: a UDP or TCP frame to zc_dport (and the reverse direction from it, zc_rmac / zc_rvid / zc_rip) on RX ring zc_ring is rewritten in its RX buffer (DMAC zc_dmac, SMAC = our MAC,
  VLAN id zc_vid, TTL-1 with incremental IP checksum) and sent from the same buffer on TX ring 0; the page
  returns to the page pool on TX completion. No skb, no GRO, no netfilter, no qdisc.
- Prototype to measure the ceiling of a stack-less forward (and later the same with SRAM buffers); one flow,
  source NAT of the flow with zc_sip / zc_sport_add (IP and UDP checksums incremental). Counters zc_fwd / zc_miss / zc_busy in debugfs rteth/rxq.
- Flow table filled by the nftables flowtable (`flags offload`) through TC_SETUP_FT (DSA hands it to the conduit):
  per-flow match and rewrite (MACs, NAT address/port, VLAN pop/push, egress port), stats back to the flowtable.
---
--- a/drivers/net/ethernet/realtek/rtl838x_eth.h
+++ b/drivers/net/ethernet/realtek/rtl838x_eth.h
@@ -285,6 +285,8 @@
 	unsigned long		packets;     /* under the txq lock (xmit) */
 	unsigned long		bytes;
 	struct sk_buff		*skb[RTETH_TX_RING_SIZE];
+	struct page		*zc_page[RTETH_TX_RING_SIZE];     /* in-place forward (#148): RX page held until TX done */
+	struct page_pool	*zc_pool[RTETH_TX_RING_SIZE];
 };
 
 struct rteth_ctrl {
--- a/drivers/net/ethernet/realtek/rtl838x_eth.c
+++ b/drivers/net/ethernet/realtek/rtl838x_eth.c
@@ -5,6 +5,10 @@
 
 #include <linux/cacheflush.h>
 #include <linux/debugfs.h>
+#include <linux/ip.h>
+#include <linux/jhash.h>
+#include <linux/tcp.h>
+#include <linux/udp.h>
 #include <linux/dma-mapping.h>
 #include <linux/etherdevice.h>
 #include <linux/genalloc.h>
@@ -27,7 +31,10 @@
 #include <linux/regmap.h>
 #include <linux/rtnetlink.h>
 #include <linux/workqueue.h>
+#include <net/checksum.h>
 #include <net/dsa.h>
+#include <net/flow_offload.h>
+#include <net/pkt_cls.h>
 #include <net/dst_metadata.h>
 #include <net/page_pool/helpers.h>
 
@@ -43,6 +50,49 @@
 module_param(tx_by_cpu, uint, 0644);
 MODULE_PARM_DESC(tx_by_cpu, "TX ring = CPU number (run time, for NAPI pinned per VPE, #65)");
 
+/* In-place forward without an skb (#148 prototype): a UDP frame to zc_dport that arrives on RX ring zc_ring is
+ * rewritten in its RX buffer (DMAC, SMAC = our MAC, VLAN id, TTL) and sent from the same buffer; the page returns
+ * to the pool when the TX completes. Steer the flow to the ring first: rteth/rxq `l3_net_route 1`.
+ */
+static uint zc;
+module_param(zc, uint, 0644);
+MODULE_PARM_DESC(zc, "1 = forward matching UDP frames in place, no skb (prototype, #148)");
+static uint zc_ring = 1;
+module_param(zc_ring, uint, 0644);
+MODULE_PARM_DESC(zc_ring, "RX ring that carries the flow (do not change under load)");
+static uint zc_dport = 5201;
+module_param(zc_dport, uint, 0644);
+static uint zc_vid;
+module_param(zc_vid, uint, 0644);
+MODULE_PARM_DESC(zc_vid, "VLAN id to write when the frame is tagged (0 = keep)");
+static unsigned char zc_dmac[ETH_ALEN];
+static unsigned int zc_dmac_n;
+module_param_array(zc_dmac, byte, &zc_dmac_n, 0644);
+MODULE_PARM_DESC(zc_dmac, "new destination MAC, 6 decimal bytes");
+static unsigned long zc_fwd, zc_miss, zc_busy, zc_hw;
+static unsigned char zc_sip[4];
+static unsigned int zc_sip_n;
+module_param_array(zc_sip, byte, &zc_sip_n, 0644);
+MODULE_PARM_DESC(zc_sip, "source NAT: new source IPv4, 4 decimal bytes (none = no NAT)");
+static uint zc_sport_add;
+module_param(zc_sport_add, uint, 0644);
+MODULE_PARM_DESC(zc_sport_add, "source NAT: added to the UDP source port (0 = keep)");
+static unsigned char zc_rmac[ETH_ALEN];
+static unsigned int zc_rmac_n;
+module_param_array(zc_rmac, byte, &zc_rmac_n, 0644);
+MODULE_PARM_DESC(zc_rmac, "reverse direction: destination MAC (the client), 6 decimal bytes");
+static uint zc_rvid;
+module_param(zc_rvid, uint, 0644);
+MODULE_PARM_DESC(zc_rvid, "reverse direction: VLAN id to write (0 = keep)");
+static unsigned char zc_rip[4];
+static unsigned int zc_rip_n;
+module_param_array(zc_rip, byte, &zc_rip_n, 0644);
+MODULE_PARM_DESC(zc_rip, "reverse direction: the client's real IPv4 (replaces the NAT address as destination)");
+static uint zc_dbg;
+module_param(zc_dbg, uint, 0644);
+MODULE_PARM_DESC(zc_dbg, "log the next N TX frames of both paths (len, cpu tag, first bytes)");
+#define RTETH_ZC_MARK	((struct sk_buff *)1UL)
+
 /* RTL930x NIC core shared with U-Boot (awto-tl-st1008f shared/rtl930x-nic, #83); ctx = regmap */
 static inline u32 rtl930x_nic_rd(void *ctx, u32 off)
 {
@@ -611,6 +661,12 @@
 			if (!tx_info->skb[i])
 				continue;
 
+			if (tx_info->skb[i] == RTETH_ZC_MARK) {
+				page_pool_put_full_page(tx_info->zc_pool[i], tx_info->zc_page[i], false);
+				tx_info->skb[i] = NULL;
+				continue;
+			}
+
 			dma_unmap_single(&ctrl->pdev->dev, dma,
 					 tx_info->skb[i]->len, DMA_TO_DEVICE);
 			rteth_free_skb(&tx_info->skb[i]);
@@ -640,6 +696,13 @@
 		if (ctrl->tx_data[r].ring[i] & RTETH_RING_OWN_HW)
 			break;
 
+		if (unlikely(tx_info->skb[i] == RTETH_ZC_MARK)) {
+			page_pool_put_full_page(tx_info->zc_pool[i], tx_info->zc_page[i], false);
+			tx_info->skb[i] = NULL;
+			tx_info->clean_count++;
+			continue;
+		}
+
 		dma_unmap_single(&ctrl->pdev->dev, ctrl->tx_data[r].frag[i].dma,
 				 tx_info->skb[i]->len, DMA_TO_DEVICE);
 		pkts++;
@@ -1242,6 +1305,10 @@
 	if (port >= 0)
 		ctrl->cfg->create_tx_header(frag, port, ctrl->cfg->tx_queue_from_priority ?
 					    min_t(u32, skb->priority, 7) : 0);
+	if (zc_dbg && port >= 0 && len > 1000) {
+		zc_dbg--;
+		pr_info("tx stack: len %u skb %u port %d tag %*ph data %*ph\n", frag->len, skb->len, port, 20, frag->cpu_tag, 32, skb->data);
+	}
 
 	/* Hand frag over to switch */
 	dma_wmb();
@@ -1359,6 +1426,463 @@
 	return 0;
 }
 
+/* Flow table filled by the nftables flowtable (flags offload) through TC_SETUP_FT (#148): one entry per direction of an
+ * established connection: match = the packet's tuple as it arrives, action = the rewrite the stack would do (Ethernet
+ * addresses, NAT address and port, VLAN pop/push, egress port). Conntrack, NAT, timeouts and new flows stay in the stack.
+ */
+#define ZC_FLOW_BITS	10
+#define ZC_FLOW_MAX	2048
+
+struct zc_act {
+	u8 dmac[ETH_ALEN], smac[ETH_ALEN];
+	bool set_dmac, set_smac, set_saddr, set_daddr, set_sport, set_dport, vlan_push;
+	u8 vlan_pop;
+	__be32 saddr, daddr;
+	__be16 sport, dport;
+	u16 vid;
+	int port;	/* DSA port index, -1 = the ingress port */
+};
+
+struct zc_flow {
+	struct hlist_node node;
+	struct rcu_head rcu;
+	unsigned long cookie;
+	__be32 saddr, daddr;
+	__be16 sport, dport;
+	u8 proto;
+	struct zc_act act;
+	atomic64_t pkts, bytes;
+	unsigned long lastused;
+};
+
+static struct hlist_head zc_tbl[1 << ZC_FLOW_BITS];
+static DEFINE_SPINLOCK(zc_lock);
+static unsigned int zc_nflows;
+static LIST_HEAD(zc_ft_cb_list);
+
+static u32 zc_hash(__be32 s, __be32 d, __be16 sp, __be16 dp, u8 proto)
+{
+	return jhash_3words((__force u32)s, (__force u32)d, (((__force u32)sp << 16) | (__force u16)dp) ^ proto, 0x5a17) >>
+	       (32 - ZC_FLOW_BITS);
+}
+
+static struct zc_flow *zc_lookup(__be32 s, __be32 d, __be16 sp, __be16 dp, u8 proto)
+{
+	struct zc_flow *z;
+
+	hlist_for_each_entry_rcu(z, &zc_tbl[zc_hash(s, d, sp, dp, proto)], node)
+		if (z->saddr == s && z->daddr == d && z->sport == sp && z->dport == dp && z->proto == proto)
+			return z;
+	return NULL;
+}
+
+static struct zc_flow *zc_find_cookie(unsigned long cookie)
+{
+	struct zc_flow *z;
+
+	for (int i = 0; i < (1 << ZC_FLOW_BITS); i++)
+		hlist_for_each_entry(z, &zc_tbl[i], node)
+			if (z->cookie == cookie)
+				return z;
+	return NULL;
+}
+
+static int zc_ft_add(struct flow_cls_offload *f)
+{
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	u8 eth[ETH_HLEN] = {}, ethm[ETH_HLEN] = {}, ip4[20] = {}, ip4m[20] = {}, l4[4] = {}, l4m[4] = {};
+	struct flow_match_ipv4_addrs ip;
+	struct flow_match_ports ports;
+	struct flow_match_basic basic;
+	struct flow_action_entry *act;
+	struct zc_flow *z;
+	struct dsa_port *dp;
+	int i, k, ret = -EOPNOTSUPP;
+
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) || !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS))
+		return -EOPNOTSUPP;
+	flow_rule_match_basic(rule, &basic);
+	if (basic.key->n_proto != htons(ETH_P_IP) || (basic.key->ip_proto != IPPROTO_TCP && basic.key->ip_proto != IPPROTO_UDP))
+		return -EOPNOTSUPP;
+	flow_rule_match_ipv4_addrs(rule, &ip);
+	flow_rule_match_ports(rule, &ports);
+
+	z = kzalloc(sizeof(*z), GFP_KERNEL);
+	if (!z)
+		return -ENOMEM;
+	z->cookie = f->cookie;
+	z->proto = basic.key->ip_proto;
+	z->saddr = ip.key->src;
+	z->daddr = ip.key->dst;
+	z->sport = ports.key->src;
+	z->dport = ports.key->dst;
+	z->act.port = -1;
+
+	flow_action_for_each(i, act, &rule->action) {
+		switch (act->id) {
+		case FLOW_ACTION_MANGLE: {
+			u8 *dst, *set;
+			unsigned int lim;
+			const u8 *m = (const u8 *)&act->mangle.mask, *v = (const u8 *)&act->mangle.val;
+
+			switch (act->mangle.htype) {
+			case FLOW_ACT_MANGLE_HDR_TYPE_ETH: {
+				/* nf_flow_table_offload.c builds the 16-bit address pieces from host-order constants
+				 * (mask ~0xffff0000 / ~0x0000ffff, val = val16 [<< 16]): byte-correct on little-endian
+				 * hosts only. Decode them by numeric value for both byte orders; the 32-bit pieces are
+				 * plain memory bytes.
+				 */
+				u32 mk = act->mangle.mask, vl = act->mangle.val;
+
+				if (act->mangle.offset == 0 && mk == 0) {		/* destination bytes 0-3 */
+					memcpy(eth, v, 4);
+					memset(ethm, 1, 4);
+				} else if (act->mangle.offset == 4 && mk == 0xffff0000) {	/* destination bytes 4-5 */
+#ifdef __BIG_ENDIAN
+					eth[4] = (vl >> 8) & 0xff, eth[5] = vl & 0xff;
+#else
+					eth[4] = vl & 0xff, eth[5] = (vl >> 8) & 0xff;
+#endif
+					ethm[4] = ethm[5] = 1;
+				} else if (act->mangle.offset == 4 && mk == 0x0000ffff) {	/* source bytes 0-1 */
+#ifdef __BIG_ENDIAN
+					eth[6] = (vl >> 24) & 0xff, eth[7] = (vl >> 16) & 0xff;
+#else
+					eth[6] = (vl >> 16) & 0xff, eth[7] = (vl >> 24) & 0xff;
+#endif
+					ethm[6] = ethm[7] = 1;
+				} else if (act->mangle.offset == 8 && mk == 0) {		/* source bytes 2-5 */
+					memcpy(eth + 8, v, 4);
+					memset(ethm + 8, 1, 4);
+				} else {
+					goto err;
+				}
+				goto mangle_done;
+			}
+			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+				dst = ip4; set = ip4m; lim = sizeof(ip4);
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+			case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+				dst = l4; set = l4m; lim = sizeof(l4);
+				break;
+			default:
+				goto err;
+			}
+			for (k = 0; k < 4; k++) {	/* byte-granular masks only: 0x00 = replaced, 0xff = kept */
+				if (m[k] != 0x00 && m[k] != 0xff)
+					goto err;
+				if (m[k] == 0x00 && act->mangle.offset + k < lim) {
+					dst[act->mangle.offset + k] = v[k];
+					set[act->mangle.offset + k] = 1;
+				}
+			}
+mangle_done:
+			break;
+		}
+		case FLOW_ACTION_CSUM:
+			break;	/* checksums are updated incrementally */
+		case FLOW_ACTION_VLAN_POP:
+			z->act.vlan_pop++;
+			break;
+		case FLOW_ACTION_VLAN_PUSH:
+			z->act.vlan_push = true;
+			z->act.vid = act->vlan.vid;
+			break;
+		case FLOW_ACTION_REDIRECT:
+			dp = dsa_port_from_netdev(act->dev);
+			if (IS_ERR(dp))
+				goto err;
+			z->act.port = dp->index;
+			break;
+		default:
+			goto err;
+		}
+	}
+	if (z->act.vlan_pop > 1 || z->act.port < 0)
+		goto err;
+	z->act.set_dmac = ethm[0] && ethm[5];
+	z->act.set_smac = ethm[6] && ethm[11];
+	memcpy(z->act.dmac, eth, ETH_ALEN);
+	memcpy(z->act.smac, eth + ETH_ALEN, ETH_ALEN);
+	z->act.set_saddr = ip4m[12] && ip4m[15];
+	z->act.set_daddr = ip4m[16] && ip4m[19];
+	memcpy(&z->act.saddr, ip4 + 12, 4);
+	memcpy(&z->act.daddr, ip4 + 16, 4);
+	z->act.set_sport = l4m[0] && l4m[1];
+	z->act.set_dport = l4m[2] && l4m[3];
+	memcpy(&z->act.sport, l4, 2);
+	memcpy(&z->act.dport, l4 + 2, 2);
+
+	spin_lock_bh(&zc_lock);
+	if (zc_nflows >= ZC_FLOW_MAX || zc_find_cookie(z->cookie)) {
+		spin_unlock_bh(&zc_lock);
+		ret = -ENOSPC;
+		goto err;
+	}
+	hlist_add_head_rcu(&z->node, &zc_tbl[zc_hash(z->saddr, z->daddr, z->sport, z->dport, z->proto)]);
+	zc_nflows++;
+	spin_unlock_bh(&zc_lock);
+	return 0;
+
+err:
+	kfree(z);
+	return ret;
+}
+
+static int zc_ft_del(unsigned long cookie)
+{
+	struct zc_flow *z;
+
+	spin_lock_bh(&zc_lock);
+	z = zc_find_cookie(cookie);
+	if (z) {
+		hlist_del_rcu(&z->node);
+		zc_nflows--;
+	}
+	spin_unlock_bh(&zc_lock);
+	if (z)
+		kfree_rcu(z, rcu);
+	return 0;
+}
+
+static int zc_ft_stats(struct flow_cls_offload *f)
+{
+	struct zc_flow *z;
+
+	spin_lock_bh(&zc_lock);
+	z = zc_find_cookie(f->cookie);
+	if (z)
+		flow_stats_update(&f->stats, atomic64_read(&z->bytes), atomic64_read(&z->pkts), 0, z->lastused,
+				  FLOW_ACTION_HW_STATS_DELAYED);
+	spin_unlock_bh(&zc_lock);
+	return 0;
+}
+
+static int zc_ft_cb(enum tc_setup_type type, void *type_data, void *cb_priv)
+{
+	struct flow_cls_offload *f = type_data;
+
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+	switch (f->command) {
+	case FLOW_CLS_REPLACE:
+		return zc_ft_add(f);
+	case FLOW_CLS_DESTROY:
+		return zc_ft_del(f->cookie);
+	case FLOW_CLS_STATS:
+		return zc_ft_stats(f);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static bool rteth_zc_forward(struct rteth_ctrl *ctrl, int ring, int slot, struct rteth_frag *frag)
+{
+	struct rteth_rx_info *rxi = &ctrl->rx_info[ring];
+	struct netdev_queue *txq = netdev_get_tx_queue(ctrl->dev, 0);
+	struct rteth_tx_info *txi = &ctrl->tx_info[0];
+	struct page *page = rxi->page[slot];
+	unsigned int off = rxi->offset[slot] + ctrl->cfg->skb_headroom;
+	unsigned int len = frag->len, l2 = ETH_HLEN, txslot;
+	u8 *p = page_address(page) + off;
+	struct zc_act sact, *a;
+	struct zc_flow *z = NULL;
+	struct rteth_dsa_tag tag;
+	struct rteth_frag *tf;
+	struct iphdr *iph;
+	__be16 *l4, *chk, old;
+	__be32 nat_ip = 0;
+	dma_addr_t dma, packet_dma;
+	bool tagged, udp_csum;
+	int port;
+
+	if (len < ETH_ZLEN + ETH_FCS_LEN)
+		goto miss;
+	tagged = p[12] == 0x81 && p[13] == 0x00;
+	if (tagged)
+		l2 += VLAN_HLEN;
+	if (p[l2 - 2] != 0x08 || p[l2 - 1] != 0x00)
+		goto miss;
+	iph = (struct iphdr *)(p + l2);
+	if (iph->ihl != 5 || iph->ttl < 2 || (iph->frag_off & htons(IP_MF | IP_OFFSET)) ||
+	    (iph->protocol != IPPROTO_UDP && iph->protocol != IPPROTO_TCP) ||
+	    len < l2 + sizeof(*iph) + (iph->protocol == IPPROTO_TCP ? sizeof(struct tcphdr) : sizeof(struct udphdr)))
+		goto miss;
+	l4 = (__be16 *)(iph + 1);
+	chk = iph->protocol == IPPROTO_TCP ? &l4[8] : &l4[3];	/* TCP checksum at +16, UDP at +6 */
+
+	rcu_read_lock();
+	z = zc_lookup(iph->saddr, iph->daddr, l4[0], l4[1], iph->protocol);
+	if (z) {
+		a = &z->act;
+	} else if (zc_dmac_n == ETH_ALEN) {	/* the static rule pair of the first prototype (module parameters) */
+		memset(&sact, 0, sizeof(sact));
+		sact.port = -1;
+		sact.set_smac = true;
+		memcpy(sact.smac, ctrl->dev->dev_addr, ETH_ALEN);
+		if (zc_sip_n == 4)
+			nat_ip = htonl((zc_sip[0] << 24) | (zc_sip[1] << 16) | (zc_sip[2] << 8) | zc_sip[3]);
+		if (l4[1] == htons(zc_dport)) {			/* client -> server: source NAT */
+			sact.set_dmac = true;
+			memcpy(sact.dmac, zc_dmac, ETH_ALEN);
+			sact.vlan_pop = tagged && zc_vid;
+			sact.vlan_push = tagged && zc_vid;
+			sact.vid = zc_vid;
+			if (nat_ip) {
+				sact.set_saddr = true;
+				sact.saddr = nat_ip;
+			}
+			if (zc_sport_add) {
+				sact.set_sport = true;
+				sact.sport = htons(ntohs(l4[0]) + zc_sport_add);
+			}
+		} else if (nat_ip && l4[0] == htons(zc_dport) && iph->daddr == nat_ip && zc_rmac_n == ETH_ALEN &&
+			   zc_rip_n == 4) {			/* server -> client: back to the client */
+			sact.set_dmac = true;
+			memcpy(sact.dmac, zc_rmac, ETH_ALEN);
+			sact.vlan_pop = tagged && zc_rvid;
+			sact.vlan_push = tagged && zc_rvid;
+			sact.vid = zc_rvid;
+			sact.set_daddr = true;
+			sact.daddr = htonl((zc_rip[0] << 24) | (zc_rip[1] << 16) | (zc_rip[2] << 8) | zc_rip[3]);
+			if (zc_sport_add) {
+				sact.set_dport = true;
+				sact.dport = htons(ntohs(l4[1]) - zc_sport_add);
+			}
+		} else {
+			rcu_read_unlock();
+			goto miss;
+		}
+		a = &sact;
+	} else {
+		rcu_read_unlock();
+		goto miss;
+	}
+	/* VLAN: replace the id, remove or insert a tag; a tag that does not fit the action stays with the stack */
+	if ((a->vlan_pop && !tagged) || (!a->vlan_pop && a->vlan_push && tagged)) {
+		rcu_read_unlock();
+		goto miss;
+	}
+
+	ctrl->cfg->decode_tag(frag, &tag);
+	port = a->port >= 0 ? a->port : tag.port;
+	udp_csum = iph->protocol == IPPROTO_TCP || *chk;	/* UDP checksum 0 = none */
+	if (a->set_saddr) {
+		csum_replace4(&iph->check, iph->saddr, a->saddr);
+		if (udp_csum)
+			csum_replace4(chk, iph->saddr, a->saddr);
+		iph->saddr = a->saddr;
+	}
+	if (a->set_daddr) {
+		csum_replace4(&iph->check, iph->daddr, a->daddr);
+		if (udp_csum)
+			csum_replace4(chk, iph->daddr, a->daddr);
+		iph->daddr = a->daddr;
+	}
+	if (a->set_sport) {
+		if (udp_csum)
+			csum_replace2(chk, l4[0], a->sport);
+		l4[0] = a->sport;
+	}
+	if (a->set_dport) {
