From: Dan <dan@awto.au>
Subject: [PATCH] irqchip/realtek-rtl: log spurious and masked-but-pending interrupts (#186)

- Spurious (GIMR & GISR & mask == 0): rate-limited warning with both CPU banks, CP0 cause and status.
- Masked source raw-pending in GISR (fired despite the GIMR mask): warning with the hwirq mask.
---
--- a/drivers/irqchip/irq-realtek-rtl.c
+++ b/drivers/irqchip/irq-realtek-rtl.c
@@ -177,8 +177,25 @@
 	pending = readl_be(REG(cpu, RTL_ICTL_GIMR)) &
 		  readl_be(REG(cpu, RTL_ICTL_GISR)) & output->mask;
 
+	/* #186: a source that is masked in this CPU's GIMR but raw-pending in GISR fired despite the mask (faulty hardware or errata) */
+	{
+		u32 raw = readl_be(REG(cpu, RTL_ICTL_GISR)) & ~readl_be(REG(cpu, RTL_ICTL_GIMR));
+
+		if (unlikely(raw))
+			pr_warn_ratelimited("realtek-intc: masked source pending on cpu%u: hwirq mask %08x (GIMR %08x GISR %08x)\n",
+					    cpu, raw, readl_be(REG(cpu, RTL_ICTL_GIMR)), readl_be(REG(cpu, RTL_ICTL_GISR)));
+	}
+
 	if (unlikely(!pending)) {
+		unsigned int other = cpu ? 0 : 1;
+
 		spurious_interrupt();
+		/* #186: which line, which CPU: both banks' enable/status and the CPU's own cause/status */
+		pr_warn_ratelimited("spurious on cpu%u parent IP%u: GIMR %08x GISR %08x, cpu%u GIMR %08x GISR %08x, mask %08x, cause %08x status %08x\n",
+				    cpu, output->parent_hwirq, readl_be(REG(cpu, RTL_ICTL_GIMR)), readl_be(REG(cpu, RTL_ICTL_GISR)),
+				    other, realtek_ictl_base[other] ? readl_be(REG(other, RTL_ICTL_GIMR)) : 0,
+				    realtek_ictl_base[other] ? readl_be(REG(other, RTL_ICTL_GISR)) : 0,
+				    output->mask, read_c0_cause(), read_c0_status());
 		goto out;
 	}
 
