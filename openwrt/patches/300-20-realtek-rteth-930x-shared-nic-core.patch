 }

+static bool rteth_930x_decode_tag(struct rteth_frag *frag, struct rteth_dsa_tag *t)
+{
+	struct rtl930x_nic_rx_tag n;
+
+	rtl930x_nic_rx_tag(frag->cpu_tag, &n);
+	t->port = n.port;
+	t->queue = n.queue;
+	t->reason = n.reason;
+	t->crc_error = n.crc_error;
+	t->l2_offloaded = n.l2_offloaded;
+	if (t->reason != 63)
+		pr_debug("%s: Reason %d, port %d, queue %d\n", __func__, t->reason, t->port, t->queue);
+
+	return t->l2_offloaded;
+}
+
 static bool rteth_93xx_decode_tag(struct rteth_frag *frag, struct rteth_dsa_tag *t)
 {
 	t->port = (frag->cpu_tag[0] >> 8) & 0x3f;
@@ -398,6 +460,26 @@
 	}
 }

+static void rteth_930x_set_hol(struct rteth_ctrl *ctrl)
+{
+	/* same budget as rteth_93xx_set_hol: only fully filled packets, no ring overflow */
+	int frags_per_pkt = DIV_ROUND_UP(ctrl->dev->mtu + RTETH_FRAME_OVERHEAD, RTETH_SKB_FRAG_SIZE);
+	int cnt = min(RTETH_RX_RING_SIZE / frags_per_pkt, 0x3ff);
+
+	for (int ring = 0; ring < RTETH_RX_RINGS; ring++)
+		rtl930x_nic_rx_ring_size(ctrl->map, ring, cnt);
+}
+
+static void rteth_930x_hw_reset(struct rteth_ctrl *ctrl)
+{
+	int us;
+
+	pr_info("RESETTING CPU_PORT %d\n", ctrl->cfg->cpu_port);
+	us = rtl930x_nic_reset(ctrl->map, RTETH_RX_RINGS);
+	if (us < 0)
+		netdev_warn(ctrl->dev, "NIC reset not done after %d us\n", RTL930X_NIC_RST_US);
+}
+
 static void rteth_93xx_hw_reset(struct rteth_ctrl *ctrl)
