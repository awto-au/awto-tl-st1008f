+static void rteth_930x_create_tx_header(struct rteth_frag *frag, unsigned int port, int prio)
+{
+	rtl930x_nic_tx_tag(frag->cpu_tag, port, prio, RTL930X_NIC_TAG1_BP_STP);
+}
