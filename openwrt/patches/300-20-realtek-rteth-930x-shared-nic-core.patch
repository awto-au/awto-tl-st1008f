Subject: realtek: rteth (rtl838x_eth) RTL930x paths on the NIC core shared with U-Boot (#83)

- RTL930x register facts, descriptor + CPU-tag layout, NIC reset, HOL ring size/counter, max length,
  enable, link down and the doorbell value come from rtl930x_nic.h. The build copies that file from
  awto-tl-st1008f shared/rtl930x-nic/ (never edit the copy); our U-Boot rtl930x_eth.c includes the same file.
- 930x gets its own create_tx_header/decode_tag/update_counter/set_hol/hw_reset; 931x keeps the 93xx ones.
- static_asserts tie the generic paths' RTETH_930X_* offsets, ring bits and rteth_frag layout to the core.
- Behaviour change: NIC reset self-clear limit 1 s -> 62.5 ms (SDK fixed 50 ms x1.25), warns on expiry.
---
--- a/drivers/net/ethernet/realtek/rtl838x_eth.c
+++ b/drivers/net/ethernet/realtek/rtl838x_eth.c
@@ -31,6 +31,42 @@

 #include "rtl838x_eth.h"

+/* RTL930x NIC core shared with U-Boot (awto-tl-st1008f shared/rtl930x-nic, #83); ctx = regmap */
+static inline u32 rtl930x_nic_rd(void *ctx, u32 off)
+{
+	u32 v;
+
+	regmap_read(ctx, off, &v);
+	return v;
+}
+
+static inline void rtl930x_nic_wr(void *ctx, u32 off, u32 v)
+{
+	regmap_write(ctx, off, v);
+}
+
+#define rtl930x_nic_msleep	msleep
+#define rtl930x_nic_udelay	udelay
+#include "rtl930x_nic.h"
+
+/* the generic paths below use the RTETH_930X_* and ring names: both must match the core */
+static_assert(RTETH_930X_DMA_IF_CTRL == RTL930X_NIC_DMA_IF_CTRL);
+static_assert(RTETH_930X_DMA_RX_BASE == RTL930X_NIC_DMA_RX_BASE);
+static_assert(RTETH_930X_DMA_TX_BASE == RTL930X_NIC_DMA_TX_BASE);
+static_assert(RTETH_930X_DMA_IF_INTR_MSK == RTL930X_NIC_DMA_INTR_MSK);
+static_assert(RTETH_930X_DMA_IF_INTR_STS == RTL930X_NIC_DMA_INTR_STS);
+static_assert(RTETH_930X_DMA_IF_RX_RING_SIZE == RTL930X_NIC_RX_RING_SIZE);
+static_assert(RTETH_930X_DMA_IF_RX_RING_CNTR == RTL930X_NIC_RX_RING_CNTR);
+static_assert(RTETH_930X_MAC_L2_PORT_CTRL == RTL930X_NIC_L2_PORT_CTRL);
+static_assert(RTETH_930X_MAC_FORCE_MODE_CTRL == RTL930X_NIC_MAC_FORCE);
+static_assert(RTETH_930X_MAC_L2_ADDR_CTRL == RTL930X_NIC_MAC_L2_ADDR);
+static_assert(RTETH_930X_QM_RSN2CPUQID_CTRL_0 == RTL930X_NIC_QM_RSN2CPUQID);
+static_assert(RTETH_930X_QM_RSN2CPUQID_CTRL_CNT == RTL930X_NIC_QM_RSN2CPUQID_N);
+static_assert(RTETH_RING_OWN_HW == RTL930X_NIC_OWN && RTETH_RING_WRAP == RTL930X_NIC_WRAP);
+static_assert(sizeof(struct rteth_frag) == sizeof(struct rtl930x_nic_hdr));
+static_assert(offsetof(struct rteth_frag, len) == offsetof(struct rtl930x_nic_hdr, len));
+static_assert(offsetof(struct rteth_frag, cpu_tag) == offsetof(struct rtl930x_nic_hdr, tag));
+
 static void rteth_838x_create_tx_header(struct rteth_frag *frag, unsigned int port, int prio)
 {
