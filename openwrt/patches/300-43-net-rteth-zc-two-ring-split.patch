+	r[13] |= pr->cpuqid_sel ? BIT(7) : 0;			/* ACT_MSK_CPUQID, lsp 167 */
+	r[17] |= ((u32)(pr->cpuqid_data) & 0x1f) << 20;		/* QID_DATA, lsp 52 */
 	r[13] |= pr->bypass_sel ? BIT(5) : 0;
 	r[13] |= pr->nopri_sel ? BIT(4) : 0;
 	r[13] |= pr->tagst_sel ? BIT(3) : 0;
