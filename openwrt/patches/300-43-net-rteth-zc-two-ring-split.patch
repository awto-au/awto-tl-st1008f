+/* ON = pages, OFF = ON - 16 (12 bit fields); 0 keeps the chip value */
+static void rteth_930x_cpuq_drop_thr(struct rteth_ctrl *ctrl, int q, uint pages)
+{
+	u32 on = min(pages, 0xfffu);
+
+	if (pages)
+		regmap_write(ctrl->map, RTETH_930X_FC_CPU_Q_EGR_DROP_THR + 4 * q,
+			     FIELD_PREP(GENMASK(27, 16), on) | FIELD_PREP(GENMASK(11, 0), on - min(on, 16u)));
+}
