+/* rteth debugfs rxq_pie (#146): CPU-QID-only IACL rules (blocks 8-15), ids kept for `clear` */
+#define OTTO_CPUQID_RULES 4
+static struct pie_rule otto_cpuqid_rule[OTTO_CPUQID_RULES];
+static int otto_cpuqid_n;
+static DEFINE_MUTEX(otto_cpuqid_lock);
+
+/* proto: 0 any, 1 UDP, 2 TCP; frames stay on the route trap, only the queue changes */
+int otto_pie_930x_cpuqid_add(struct otto_dsa_priv *priv, bool dport, u16 mask, u16 value, int proto, u8 ring)
+{
+	struct pie_rule *pr;
+	int err;
+
+	guard(mutex)(&otto_cpuqid_lock);
+	if (otto_cpuqid_n >= OTTO_CPUQID_RULES)
+		return -ENOSPC;
+	pr = &otto_cpuqid_rule[otto_cpuqid_n];
+	memset(pr, 0, sizeof(*pr));
+	pr->phase = PHASE_IACL;
+	pr->is_egress = true;
+	pr->packet_cntr = -1;
+	pr->frame_type = 2;
+	pr->frame_type_m = 3;
+	if (proto) {
+		pr->frame_type_l4 = proto == 2;
+		pr->frame_type_l4_m = 7;
+	}
+	if (dport) {
+		pr->dport = value;
+		pr->dport_m = mask;
+	} else {
+		pr->sport = value;
+		pr->sport_m = mask;
+	}
+	pr->cpuqid_sel = true;
+	pr->cpuqid_data = ring;
+	err = otto_pie_930x_rule_add(priv, pr);
+	if (!err)
+		otto_cpuqid_n++;
+	return err;
+}
+EXPORT_SYMBOL_GPL(otto_pie_930x_cpuqid_add);
+
+void otto_pie_930x_cpuqid_clear(struct otto_dsa_priv *priv)
+{
+	guard(mutex)(&otto_cpuqid_lock);
+	while (otto_cpuqid_n > 0)
+		otto_pie_930x_rule_rm(priv, &otto_cpuqid_rule[--otto_cpuqid_n]);
+}
+EXPORT_SYMBOL_GPL(otto_pie_930x_cpuqid_clear);
+
+void otto_pie_930x_cpuqid_show(struct seq_file *m)
+{
+	guard(mutex)(&otto_cpuqid_lock);
+	for (int i = 0; i < otto_cpuqid_n; i++) {
+		struct pie_rule *pr = &otto_cpuqid_rule[i];
+
+		seq_printf(m, "pie_rule%d idx %d %s mask 0x%x value 0x%x l4 %s ring %u\n", i, pr->id,
+			   pr->dport_m ? "dport" : "sport", pr->dport_m ? pr->dport_m : pr->sport_m,
+			   pr->dport_m ? pr->dport : pr->sport,
+			   pr->frame_type_l4_m ? (pr->frame_type_l4 ? "tcp" : "udp") : "any", pr->cpuqid_data);
+	}
+}
+EXPORT_SYMBOL_GPL(otto_pie_930x_cpuqid_show);
+
