+/* `rxq_pie <sport|dport> <mask> <value> <ring> [udp|tcp|any]` installs one IPv4 PIE rule (CPU queue action only),
+ * `rxq_pie clear` removes ours; values are numeric (0x ok). Install before traffic: a flow that changes ring reorders.
+ */
+static void *rteth_dsa_priv(struct rteth_ctrl *ctrl)
+{
+	struct dsa_port *cpu_dp = ctrl->dev->dsa_ptr;
+
+	return cpu_dp ? cpu_dp->ds->priv : NULL;
+}
+
+static int rteth_rxq_pie_show(struct seq_file *m, void *unused)
+{
+	if (IS_BUILTIN(CONFIG_NET_DSA_RTL83XX))
+		otto_pie_930x_cpuqid_show(m);
+	return 0;
+}
+
+static ssize_t rteth_rxq_pie_write(struct file *file, const char __user *buf, size_t len, loff_t *off)
+{
+	struct rteth_ctrl *ctrl = file_inode(file)->i_private;
+	char line[64], field[8], l4[8] = "udp";
+	unsigned int ring;
+	int mask, value;
+	void *priv;
+	int n, err;
+
+	if (!IS_BUILTIN(CONFIG_NET_DSA_RTL83XX) || ctrl->cfg->qm_rsn2cpuqid_ctrl != 0xa344)
+		return -EOPNOTSUPP;
+	if (len >= sizeof(line))
+		return -EINVAL;
+	if (copy_from_user(line, buf, len))
+		return -EFAULT;
+	line[len] = 0;
+	priv = rteth_dsa_priv(ctrl);
+	if (!priv)
+		return -ENODEV;
+	if (!strncmp(line, "clear", 5)) {
+		otto_pie_930x_cpuqid_clear(priv);
+		return len;
+	}
+	n = sscanf(line, "%7s %i %i %u %7s", field, &mask, &value, &ring, l4);
+	if (n < 4 || mask < 0 || mask > 0xffff || value < 0 || value > 0xffff || ring >= RTETH_RX_RINGS ||
+	    (strcmp(field, "sport") && strcmp(field, "dport")) ||
+	    (strcmp(l4, "udp") && strcmp(l4, "tcp") && strcmp(l4, "any")))
+		return -EINVAL;
+	err = otto_pie_930x_cpuqid_add(priv, !strcmp(field, "dport"), mask, value,
+				       !strcmp(l4, "udp") ? 1 : !strcmp(l4, "tcp") ? 2 : 0, ring);
+	return err ? err : len;
+}
+
+static int rteth_rxq_pie_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, rteth_rxq_pie_show, inode->i_private);
+}
+
+static const struct file_operations rteth_rxq_pie_fops = {
+	.owner = THIS_MODULE, .open = rteth_rxq_pie_open, .read = seq_read, .write = rteth_rxq_pie_write,
+	.llseek = seq_lseek, .release = single_release,
+};
+
 static int rteth_rxq_open(struct inode *inode, struct file *file)
 {
 	return single_open(file, rteth_rxq_show, inode->i_private);
@@ -2090,6 +2204,7 @@
 	struct dentry *dir = debugfs_create_dir("rteth", NULL);
 
 	debugfs_create_file("rxq", 0600, dir, ctrl, &rteth_rxq_fops);
+	debugfs_create_file("rxq_pie", 0600, dir, ctrl, &rteth_rxq_pie_fops);
 	devm_add_action_or_reset(ctrl->dev->dev.parent, rteth_debugfs_remove, dir);
 }
 
