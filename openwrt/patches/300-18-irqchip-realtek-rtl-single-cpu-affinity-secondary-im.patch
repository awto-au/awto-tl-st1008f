Subject: irqchip/realtek-rtl: one target CPU per IRQ; open the parent lines on secondary VPEs (#73)

- set_affinity kept the whole mask as effective affinity and unmask enabled GIMR on every CPU in it.
- vsmp_init_secondary() unmasks only IP0/1/6/7 on VPE1: an IRQ on IP2-5 with affinity CPU1 was
  never taken (eth0 pinned to CPU1 = NIC dead). A STARTING hook sets the parent IM bits.
- Single target = first online CPU in the mask (forced: first CPU), as most irqchips do.
---
--- a/include/linux/cpuhotplug.h
+++ b/include/linux/cpuhotplug.h
@@ -140,6 +140,7 @@
 	CPUHP_AP_IRQ_ARMADA_XP_STARTING,
 	CPUHP_AP_IRQ_BCM2836_STARTING,
 	CPUHP_AP_IRQ_MIPS_GIC_STARTING,
+	CPUHP_AP_IRQ_REALTEK_STARTING,
 	CPUHP_AP_IRQ_EIOINTC_STARTING,
 	CPUHP_AP_IRQ_AVECINTC_STARTING,
 	CPUHP_AP_IRQ_SIFIVE_PLIC_STARTING,
--- a/drivers/irqchip/irq-realtek-rtl.c
+++ b/drivers/irqchip/irq-realtek-rtl.c
@@ -15,6 +15,8 @@
 #include <linux/spinlock.h>
 #include <linux/of_address.h>
 #include <linux/irqchip/chained_irq.h>
+#include <linux/cpuhotplug.h>
+#include <asm/mipsregs.h>
 
 /* Global Interrupt Mask Register */
 #define RTL_ICTL_GIMR		0x00
@@ -41,6 +43,8 @@
 
 static DEFINE_RAW_SPINLOCK(irq_lock);
 static void __iomem *realtek_ictl_base[NR_CPUS];
+/* CP0 Status IM bits of our parent lines: irq-mips-cpu unmasks them on the boot CPU only */
+static u32 realtek_ictl_parent_im;
 
 /*
  * IRR0-IRR3 store 4 bits per interrupt, but Realtek uses inverted numbering,
@@ -101,10 +105,16 @@
 
 static int realtek_ictl_irq_affinity(struct irq_data *i, const struct cpumask *dest, bool force)
 {
+	/* one target CPU: a level IRQ enabled in every CPU's GIMR interrupts all of them */
+	unsigned int cpu = force ? cpumask_first(dest) : cpumask_first_and(dest, cpu_online_mask);
+
+	if (cpu >= nr_cpu_ids || !realtek_ictl_base[cpu])
+		return -EINVAL;
+
 	if (!irqd_irq_masked(i))
 		realtek_ictl_mask_irq(i);
 
-	irq_data_update_effective_affinity(i, dest);
+	irq_data_update_effective_affinity(i, cpumask_of(cpu));
 
 	if (!irqd_irq_masked(i))
 		realtek_ictl_unmask_irq(i);
@@ -236,6 +246,7 @@
 		output[p].index = p;
 		output[p].parent_irq = parent_irq;
 		output[p].parent_hwirq = irqd_to_hwirq(parent_data);
+		realtek_ictl_parent_im |= STATUSF_IP0 << output[p].parent_hwirq;
 		irq_set_chained_handler_and_data(parent_irq, realtek_irq_dispatch, &output[p]);
 	}
 
@@ -252,9 +263,17 @@
 	return err;
 }
 
+/* secondary VPE: vsmp_init_secondary() unmasks only IP0/1/6/7; open every intc parent line */
+static int realtek_ictl_cpu_starting(unsigned int cpu)
+{
+	set_c0_status(realtek_ictl_parent_im);
+	return 0;
+}
+
 static int __init realtek_rtl_of_init(struct device_node *node, struct device_node *parent)
 {
 	unsigned int cpu;
+	int ret;
 
 	for_each_present_cpu(cpu) {
 		realtek_ictl_base[cpu] = of_iomap(node, cpu);
@@ -268,7 +287,12 @@
 		}
 	}
 
-	return realtek_setup_parents(node);
+	ret = realtek_setup_parents(node);
+	if (ret)
+		return ret;
+
+	return cpuhp_setup_state_nocalls(CPUHP_AP_IRQ_REALTEK_STARTING, "irqchip/realtek:starting",
+					 realtek_ictl_cpu_starting, NULL);
 }
 
 IRQCHIP_DECLARE(realtek_rtl_intc, "realtek,rtl-intc", realtek_rtl_of_init);
