From: Dan <dan@awto.au>
Subject: [PATCH] mips: name the CPU interrupt line in spurious_interrupt() (#186)

- ERR in /proc/interrupts counts these without a source; log CPU, Cause.IP, Status.IM, Count and Compare, rate-limited.
---
--- a/arch/mips/kernel/irq.c
+++ b/arch/mips/kernel/irq.c
@@ -24,6 +24,7 @@
 #include <linux/irqdomain.h>
 
 #include <linux/atomic.h>
+#include <asm/mipsregs.h>
 #include <linux/uaccess.h>
 
 void *irq_stack[NR_CPUS];
@@ -48,6 +49,10 @@
 asmlinkage void spurious_interrupt(void)
 {
 	atomic_inc(&irq_err_count);
+	/* #186: which CPU line fired: Cause.IP7..IP0 = bits 15..8, Status.IM = bits 15..8 */
+	pr_warn_ratelimited("spurious interrupt cpu%u: cause %08x (IP %02x) status %08x (IM %02x) count %08x compare %08x\n",
+			    smp_processor_id(), read_c0_cause(), (read_c0_cause() >> 8) & 0xff,
+			    read_c0_status(), (read_c0_status() >> 8) & 0xff, read_c0_count(), read_c0_compare());
 }
 
 void __init init_IRQ(void)
