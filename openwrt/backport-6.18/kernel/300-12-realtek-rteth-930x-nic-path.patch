+/*
+ * Issue send for 1 or 2 triggers. On some SoCs (especially RTL838x) there is a known bug, where
+ * the hardware sometimes reads empty values from the register. Work around that with a poll
+ * that checks if TX/RX is enabled in the register.
+ */
+static void rteth_83xx_tx_kick(struct rteth_ctrl *ctrl, int ring)
+{
+	u32 val;
+
+	spin_lock(&ctrl->tx_lock);
+	if (regmap_read_poll_timeout(ctrl->map, ctrl->cfg->dma_if_ctrl,
+				     val, val & ctrl->cfg->tx_rx_enable, 0, 5000))
+		netdev_warn_once(ctrl->dev, "DMA interface ctrl register read failed\n");
+
+	regmap_write(ctrl->map, ctrl->cfg->dma_if_ctrl, val | RTETH_TX_TRIGGER(ctrl, ring));
+	spin_unlock(&ctrl->tx_lock);
+}
+
+/*
+ * RTL930x: TX_*_FETCH self-clear and no other bit changes while the queues run (SDK
+ * r9300_nicTxFetch_set: plain field write, no poll), so one MMIO write of the cached value.
+ */
+static void rteth_930x_tx_kick(struct rteth_ctrl *ctrl, int ring)
+{
+	writel_relaxed(ctrl->dma_if_ctrl_val | RTETH_TX_TRIGGER(ctrl, ring),
+		       ctrl->base + ctrl->cfg->dma_if_ctrl);
+}
