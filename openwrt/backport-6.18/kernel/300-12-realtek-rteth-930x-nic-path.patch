+static void rteth_get_stats64(struct net_device *dev, struct rtnl_link_stats64 *stats)
+{
+	struct rteth_ctrl *ctrl = netdev_priv(dev);
+
+	netdev_stats_to_stats64(stats, &dev->stats);
