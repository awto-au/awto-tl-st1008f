#!/bin/sh
# st1008f-linkcheck: live SFP links before netifd bridges the ports (#97; U-Boot twin: rtk linkcheck).
# Per lanN (= cage N): module present, DDM RX power + soft RX_LOS (`ethtool -m` A2), carrier.
# Live = RX >= 5 uW (-23 dBm), LOS 0, or carrier; copper modules and DACs count live (no light to see).
# Same vendor + serial on two ports = one cable = LOOP (passive DAC between two cages, #110).
# More than one live port or a loop, and a bridge with STP off -> STP on in uci (committed), logged.
# Exit 0 = <= 1 live, 3 = multi live, 4 = loop (STP ensured). Output: one line per port + verdict.

RX_LIVE=50	# 0.1 uW units: 5 uW = -23 dBm; a dark SR reads 1
live=0
names=""
ids=""	# "vendor/serial port" per module, for the same-cable check

# byte N of the `ethtool -m` hex dump (A0 0-255, A2 256-511); OpenWrt's ethtool prints hex only
byte() { echo "$hex" | awk -v i="$1" '{ v = $(i + 1); print (v == "" ? -1 : ("0x" v) + 0) }'; }

for d in /sys/class/net/lan*; do
	p=${d##*/}
	hex=$(ethtool -m "$p" 2>/dev/null | awk '/^0x/ { for (i = 2; i <= NF; i++) printf "%s ", $i }')
	[ -n "$hex" ] || { echo "linkcheck $p: empty"; continue; }
	rx=-1
	los=-
	if [ $(( $(byte 92) & 0x40 )) -ne 0 ] && [ "$(byte 361)" -ge 0 ]; then	# DDM, A2 present
		rx=$(( $(byte 360) * 256 + $(byte 361) ))	# A2 104-105, internal calibration
		[ $(( $(byte 93) & 0x10 )) -ne 0 ] && los=$(( ($(byte 366) >> 1) & 1 ))	# soft RX_LOS
	fi
	b36=$(byte 36)
	# copper: 1000BASE-T (A0 6 bit 3), RJ45 (A0 2 = 0x22), 10GBASE-T (A0 36 = 0x16/0x1c), or PN "...-T"
	# (FS SFP-10G-T claims 10GBASE-SR + LC and fakes DDM: RX 0, LOS 1)
	pn=$(echo "$hex" | awk '{ s = ""; for (i = 41; i <= 56; i++) { c = ("0x" $i) + 0; if (c > 32 && c < 127) s = s sprintf("%c", c) } print s }')
	vs=$(echo "$hex" | awk '{ s = ""; for (i = 21; i <= 36; i++) { c = ("0x" $i) + 0; if (c > 32 && c < 127) s = s sprintf("%c", c) }
		s = s "/"; for (i = 69; i <= 84; i++) { c = ("0x" $i) + 0; if (c > 32 && c < 127) s = s sprintf("%c", c) } print s }')
	case "$vs" in */) ;; *) ids="$ids
$vs $p" ;; esac
	copper=0
	{ [ $(( $(byte 6) & 0x08 )) -ne 0 ] || [ "$(byte 2)" = 34 ] || [ "$b36" = 22 ] || [ "$b36" = 28 ] ||
	  case "$pn" in *-T) true ;; *) false ;; esac; } && copper=1
	car=$(cat "$d/carrier" 2>/dev/null)
	is=no
	[ "$rx" -ge $RX_LIVE ] && is=YES
	[ "$los" = 0 ] && is=YES
	[ "$car" = 1 ] && is=YES
	[ $copper = 1 ] && is=YES	# PHY not up before netifd: a copper link cannot be ruled out
	[ $(( $(byte 8) & 0x0c )) -ne 0 ] && is=YES	# DAC: electrical, no light, no TX-disable
	echo "linkcheck $p: rx $rx (0.1 uW), los $los, carrier ${car:--}, copper $copper, live $is"
	[ $is = YES ] && { live=$((live + 1)); names="$names $p"; }
done

verdict=OK
[ $live -gt 1 ] && verdict=MULTI
loops=$(echo "$ids" | awk 'NF == 2 { if ($1 in p) print p[$1] "<->" $2; else p[$1] = $2 }')
for l in $loops; do
	echo "linkcheck loop $l: same cable (vendor/serial at both ports)"
	verdict=LOOP
done
if [ $verdict != OK ]; then
	for s in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)\.type='bridge'$/\1/p"); do
		[ "$(uci -q get network.$s.stp)" = 1 ] && continue
		uci set network.$s.stp=1
		uci commit network
		logger -t st1008f-linkcheck "bridge $s: STP was off with $live live ports ($names): STP on"
		echo "linkcheck bridge $s: STP turned on"
	done
fi
echo "linkcheck verdict: live $live ($names ), => $verdict"
logger -t st1008f-linkcheck "live $live ($names ) => $verdict"
[ $verdict = LOOP ] && exit 4
[ $verdict = OK ] || exit 3
exit 0
