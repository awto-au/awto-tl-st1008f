#!/bin/sh
# Device compat_version follows board.json (board.d: 2.0 = A/B, #117). A kept config (sysupgrade -F from
# 1.0) never gets it from config_generate, and sysupgrade compares images against this value.
v=$(jsonfilter -i /etc/board.json -e @.system.compat_version 2>/dev/null)
[ -n "$v" ] || exit 0
[ "$(uci -q get system.@system[0].compat_version)" = "$v" ] && exit 0
uci set system.@system[0].compat_version="$v"
uci commit system
exit 0
