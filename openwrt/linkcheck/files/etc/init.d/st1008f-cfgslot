#!/bin/sh /etc/rc.common
# Config A/B slots (#118, st1008f-cfgslot): restore from the newest valid slot when the overlay holds no marker
# (fresh overlay after sysupgrade -n / failed JFFS2), save after every uci commit of the main configs.
START=05
USE_PROCD=1

MARK=/etc/.st1008f-cfgslot	# lives in the overlay: present = this overlay has been through a save/restore

start_service() {
	if [ ! -e $MARK ] && st1008f-cfgslot status | grep -q '^active: [01]'; then
		st1008f-cfgslot restore && : > $MARK	# before network (START=20) reads its config
	fi
	( st1008f-cfgslot save >/dev/null 2>&1 && : > $MARK ) &
	# procd drops config triggers of a service without an instance: keep an idle one
	procd_open_instance
	procd_set_param command /usr/bin/tail -f /dev/null
	procd_close_instance
}

reload_service() {
	st1008f-cfgslot save >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger network system dhcp firewall dropbear uhttpd rpcd snmpd lldpd
}
