#!/bin/sh /etc/rc.common
# Boot self-test (#108, docs/SELFTEST.md) after network + linkcheck; in the background, never blocks boot.
# Summary line on the console + syslog; full log /tmp/st1008f-selftest.log, JSON /tmp/st1008f-selftest.json.
# Off: ENABLED=0 in /etc/st1008f-selftest.conf.

START=99

# bridge `switch` appears ~27 s uptime, S99 starts ~15 s: 12 s expected x1.25 (as st1008f-bootok)
WAIT_S=15

start() {
	ENABLED=1
	# shellcheck disable=SC1091
	[ -r /etc/st1008f-selftest.conf ] && . /etc/st1008f-selftest.conf
	[ "$ENABLED" = 1 ] || return 0
	(
		i=0
		while [ ! -e /sys/class/net/switch/bridge ] && [ $i -lt $WAIT_S ]; do
			sleep 1
			i=$((i + 1))
		done
		/usr/sbin/st1008f-selftest --quiet --console
	) >/dev/null 2>&1 &
	return 0
}
